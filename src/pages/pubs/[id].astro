---
// A single paper's page: metadata, action buttons, the abstract (the Markdown
// body), and a copy-able BibTeX block. One page is generated per file in the
// `publications` collection.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  getPublications,
  yearOf,
  isOwner,
  actionLinks,
  bibtexFor,
  thumbSrc,
  localPdfHref,
  plainAbstract,
  type Pub,
} from '../../lib/pubs';
import { site } from '../../site.config';
import { personLd, jsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs.map((pub) => ({ params: { id: pub.id }, props: { pub } }));
}

interface Props {
  pub: Pub;
}
const { pub } = Astro.props;
const { Content } = await render(pub);

const links = actionLinks(pub);
const bibtex = bibtexFor(pub);
const meta = [pub.data.type, pub.data.venueShort, String(yearOf(pub))].filter(Boolean);
const { summary, keyFindings = [] } = pub.data;

// ---- Machine-readable metadata --------------------------------------------
// Everything below is derived from frontmatter, so a new paper file gets it
// for free. Absolute URLs throughout: crawlers don't resolve relative ones.
const abs = (path: string) => new URL(path, Astro.site).href;
const pageUrl = abs(Astro.url.pathname);
const pdfUrl = localPdfHref(pub) ? abs(localPdfHref(pub)!) : pub.data.links?.pdf;
const doi = pub.data.links?.doi;
const abstract = plainAbstract(pub);

// Search snippet: the plain-language summary when there is one, else the
// opening of the abstract, clipped at a word boundary.
const clip = (t: string, n = 160) =>
  t.length <= n ? t : t.slice(0, t.lastIndexOf(' ', n - 1)).replace(/[,.;:]$/, '') + '…';
const description = clip(summary ?? abstract);

// Google Scholar reads the Highwire Press `citation_*` tags. The venue tag
// depends on the kind of publication.
const d = pub.data.date;
const pad = (n: number) => String(n).padStart(2, '0');
const scholarDate = `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())}`;
const kind = (pub.data.type ?? '').toLowerCase();
const venueTag = kind.includes('journal')
  ? 'citation_journal_title'
  : kind.includes('report')
    ? 'citation_technical_report_institution'
    : 'citation_conference_title';

const scholarlyArticle = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  '@id': `${pageUrl}#article`,
  headline: pub.data.title,
  name: pub.data.title,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  author: pub.data.authors.map((name) =>
    isOwner(name) ? personLd(Astro.site!) : { '@type': 'Person', name },
  ),
  datePublished: d.toISOString().slice(0, 10),
  isPartOf: { '@type': 'CreativeWork', name: pub.data.venue },
  abstract,
  ...(summary && { description: summary }),
  ...(doi && {
    identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: doi },
    sameAs: `https://doi.org/${doi}`,
  }),
  ...(pdfUrl && { encoding: { '@type': 'MediaObject', contentUrl: pdfUrl, encodingFormat: 'application/pdf' } }),
  ...(thumbSrc(pub) && { image: abs(thumbSrc(pub)!) }),
  ...(pub.data.links?.code && { isBasedOn: pub.data.links.code }),
  inLanguage: 'en',
};
---

<Layout
  title={pub.data.title}
  description={description}
  active="publications"
  ogType="article"
  image={thumbSrc(pub) ?? undefined}
>
  <Fragment slot="head">
    <meta name="citation_title" content={pub.data.title} />
    {pub.data.authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={scholarDate} />
    <meta name={venueTag} content={pub.data.venue} />
    {doi && <meta name="citation_doi" content={doi} />}
    {pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
    <meta name="citation_abstract_html_url" content={pageUrl} />
    <meta name="citation_language" content="en" />
    <meta property="article:published_time" content={scholarlyArticle.datePublished} />
    <script type="application/ld+json" set:html={jsonLd(scholarlyArticle)} />
  </Fragment>
  <main class="wrap paper">
    <a class="back" href={`${import.meta.env.BASE_URL}pubs/`}>← Publications</a>

    <header class="head">
      <p class="meta">{meta.join(' · ')}</p>
      <h1>{pub.data.title}</h1>
      {pub.data.award && <p class="award-badge">🏆 {pub.data.award}</p>}

      <p class="authors">
        {pub.data.authors.map((a, i) => (
          <>{i > 0 ? ', ' : ''}<span class:list={['author', { me: isOwner(a) }]}>{a}</span></>
        ))}
      </p>

      <p class="venue">
        {pub.data.venue}, {yearOf(pub)}
        {pub.data.note ? <span class="note"> · {pub.data.note}</span> : null}
      </p>

      {links.length > 0 && (
        <div class="actions">
          {links.map((l) => (
            <a class="btn" href={l.href}>{l.label}</a>
          ))}
        </div>
      )}
    </header>

    {summary && (
      <section class="summary">
        <h2 class="kicker">In short</h2>
        <p class="lede">{summary}</p>
      </section>
    )}

    {keyFindings.length > 0 && (
      <section class="findings">
        <h2 class="kicker">Key findings</h2>
        <ul>
          {keyFindings.map((f) => <li>{f}</li>)}
        </ul>
      </section>
    )}

    <section class="abstract">
      <h2 class="kicker">Abstract</h2>
      <div class="prose"><Content /></div>
    </section>

    <section class="cite">
      <div class="cite-head">
        <h2 class="kicker">Cite</h2>
        <button class="copy" data-copy type="button">Copy</button>
      </div>
      <pre id="bibtex">{bibtex}</pre>
    </section>
  </main>
</Layout>

<style>
  /* Same 64rem `.wrap` as every other page, so the left edge lines up with the
     nav mark. Only set vertical padding -- the `padding` shorthand would zero
     out the horizontal padding `.wrap` provides. The reading column is capped
     separately below, the way the index pages cap their lede. */
  /* Publications carry the blue accent used for the section everywhere else
     (nav dot, eyebrow on /pubs/). Set once here; the meta dot, section kickers,
     action buttons and links below all read from it. */
  .paper {
    --accent: var(--p-blue-fg);
    --accent-bg: var(--p-blue-bg);
    padding-top: clamp(2rem, 6vw, 4rem); padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  /* Hairlines run the full width (as the year rules do on /pubs/); the text
     itself keeps a readable measure. */
  .head h1, .authors, .prose, #bibtex { max-width: 48rem; }

  .back {
    display: inline-block; margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    font-family: var(--mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em;
    color: var(--muted); text-decoration: none; transition: color .2s;
  }
  .back:hover { color: var(--accent); }

  .head { border-bottom: 1px solid var(--line); padding-bottom: clamp(1.5rem, 4vw, 2.2rem); }
  /* Accent dot echoes the eyebrow on /pubs/ and the nav. */
  .meta {
    display: inline-flex; align-items: center; gap: .5rem;
    margin: 0 0 .9rem; font-family: var(--mono); font-size: .7rem;
    text-transform: uppercase; letter-spacing: .1em; color: var(--muted);
  }
  .meta::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%; flex: none;
    background: var(--accent);
  }
  .head h1 {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(1.8rem, 5vw, 2.8rem); line-height: 1.12; letter-spacing: -0.02em; margin: 0 0 1rem;
  }
  .authors { margin: 0 0 .35rem; font-size: 1.02rem; color: var(--muted); }
  .author.me { color: var(--accent); font-weight: 600; }
  .venue { margin: 0; font-family: var(--mono); font-size: .74rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .venue .note { text-transform: none; letter-spacing: 0; font-style: italic; }

  .award-badge {
    display: inline-block; margin: .9rem 0 0;
    font-family: var(--sans); font-size: .82rem; font-weight: 600;
    color: var(--p-yellow-fg); background: var(--p-yellow-bg);
    border: 1px solid color-mix(in srgb, var(--p-yellow-fg) 30%, transparent);
    border-radius: 999px; padding: .3rem .8rem .3rem .65rem;
  }

  .actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.4rem; }
  .btn {
    font-family: var(--mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--accent); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); border-radius: 8px;
    padding: .5rem .85rem;
    background: var(--surface); transition: border-color .2s, background .2s;
  }
  .btn:hover { border-color: var(--accent); background: var(--accent-bg); }

  .kicker {
    display: inline-flex; align-items: center; gap: .5rem;
    font-family: var(--mono); font-size: .68rem; text-transform: uppercase;
    letter-spacing: .12em; color: var(--muted); margin: 0 0 .9rem; font-weight: 500;
  }
  .kicker::before {
    content: ""; width: 5px; height: 5px; border-radius: 50%; flex: none;
    background: color-mix(in srgb, var(--accent) 65%, transparent);
  }

  .summary, .findings { padding-top: clamp(1.8rem, 5vw, 2.6rem); }
  .lede, .findings ul { max-width: 48rem; }
  .lede { margin: 0; font-family: var(--serif); font-size: 1.28rem; line-height: 1.55; }
  .findings ul { margin: 0; padding-left: 1.1rem; font-size: 1.02rem; }
  .findings li { margin: 0 0 .5rem; }
  .findings li::marker { color: var(--accent); }

  .abstract { padding: clamp(1.8rem, 5vw, 2.6rem) 0; }
  .prose { font-family: var(--serif); font-size: 1.12rem; line-height: 1.7; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(a) {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    text-decoration: none; transition: border-color .2s;
  }
  .prose :global(a:hover) { border-bottom-color: var(--accent); }

  .cite { border-top: 1px solid var(--line); padding-top: clamp(1.8rem, 5vw, 2.4rem); }
  .cite-head { display: flex; align-items: center; justify-content: space-between; }
  .cite-head .kicker { margin-bottom: 0; }
  .copy {
    font-family: var(--mono); font-size: .66rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--muted); background: transparent; border: 1px solid var(--line);
    border-radius: 6px; padding: .3rem .6rem; cursor: pointer; transition: color .2s, border-color .2s;
  }
  .copy:hover { color: var(--accent); border-color: var(--accent); }
  .cite pre {
    margin: .9rem 0 0; padding: 1rem 1.1rem; overflow-x: auto;
    background: var(--surface); border: 1px solid var(--line);
    border-left: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 10px;
    font-family: var(--mono); font-size: .74rem; line-height: 1.55; color: var(--ink);
    white-space: pre;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const pre = document.getElementById('bibtex');
  btn?.addEventListener('click', async () => {
    if (!pre?.textContent) return;
    await navigator.clipboard.writeText(pre.textContent);
    const prev = btn.textContent;
    btn.textContent = 'Copied';
    setTimeout(() => (btn.textContent = prev), 1500);
  });
</script>
