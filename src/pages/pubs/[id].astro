---
// A single paper's page: metadata and the abstract (the Markdown body) up
// top, then action buttons, the plain-language panel, one figure from the
// paper, and a copy-able BibTeX block. One page is generated per file in the
// `publications` collection.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  getPublications,
  yearOf,
  isOwner,
  actionLinks,
  bibtexFor,
  thumbSrc,
  figureSrc,
  localPdfHref,
  plainAbstract,
  type Pub,
} from '../../lib/pubs';
import { site } from '../../site.config';
import { clip } from '../../lib/text';
import { personLd, jsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs.map((pub) => ({ params: { id: pub.id }, props: { pub } }));
}

interface Props {
  pub: Pub;
}
const { pub } = Astro.props;
const { Content } = await render(pub);

const links = actionLinks(pub);
const bibtex = bibtexFor(pub);
const meta = [pub.data.type, pub.data.venueShort, String(yearOf(pub))].filter(Boolean);
const { summary, keyFindings = [], figure } = pub.data;
const figSrc = figureSrc(pub);

// ---- Machine-readable metadata --------------------------------------------
// Everything below is derived from frontmatter, so a new paper file gets it
// for free. Absolute URLs throughout: crawlers don't resolve relative ones.
const abs = (path: string) => new URL(path, Astro.site).href;
const pageUrl = abs(Astro.url.pathname);
const pdfUrl = localPdfHref(pub) ? abs(localPdfHref(pub)!) : pub.data.links?.pdf;
const doi = pub.data.links?.doi;
const abstract = plainAbstract(pub);

// Search snippet: the plain-language summary when there is one, else the
// opening of the abstract.
const description = clip(summary ?? abstract);

// Google Scholar reads the Highwire Press `citation_*` tags. The venue tag
// depends on the kind of publication.
const d = pub.data.date;
const pad = (n: number) => String(n).padStart(2, '0');
const scholarDate = `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())}`;
const kind = (pub.data.type ?? '').toLowerCase();
const venueTag = kind.includes('journal')
  ? 'citation_journal_title'
  : kind.includes('report')
    ? 'citation_technical_report_institution'
    : 'citation_conference_title';

const scholarlyArticle = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  '@id': `${pageUrl}#article`,
  headline: pub.data.title,
  name: pub.data.title,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  author: pub.data.authors.map((name) =>
    isOwner(name) ? personLd(Astro.site!) : { '@type': 'Person', name },
  ),
  datePublished: d.toISOString().slice(0, 10),
  isPartOf: { '@type': 'CreativeWork', name: pub.data.venue },
  abstract,
  ...(summary && { description: summary }),
  ...(doi && {
    identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: doi },
    sameAs: `https://doi.org/${doi}`,
  }),
  ...(pdfUrl && { encoding: { '@type': 'MediaObject', contentUrl: pdfUrl, encodingFormat: 'application/pdf' } }),
  // The first-page thumbnail, plus the paper's figure with its caption.
  image: [
    ...(thumbSrc(pub) ? [abs(thumbSrc(pub)!)] : []),
    ...(figure && figSrc
      ? [{ '@type': 'ImageObject', contentUrl: abs(figSrc), caption: figure.caption, description: figure.alt }]
      : []),
  ],
  ...(pub.data.links?.code && { isBasedOn: pub.data.links.code }),
  inLanguage: 'en',
};
---

<Layout
  title={pub.data.title}
  description={description}
  active="publications"
  ogType="article"
  image={thumbSrc(pub) ?? undefined}
>
  <Fragment slot="head">
    <meta name="citation_title" content={pub.data.title} />
    {pub.data.authors.map((a) => <meta name="citation_author" content={a} />)}
    <meta name="citation_publication_date" content={scholarDate} />
    <meta name={venueTag} content={pub.data.venue} />
    {doi && <meta name="citation_doi" content={doi} />}
    {pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
    <meta name="citation_abstract_html_url" content={pageUrl} />
    <meta name="citation_language" content="en" />
    <meta property="article:published_time" content={scholarlyArticle.datePublished} />
    <script type="application/ld+json" set:html={jsonLd(scholarlyArticle)} />
  </Fragment>
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <p class="label"><a class="back" href={`${import.meta.env.BASE_URL}pubs/`}>← All publications</a></p>
      <div>
        <p class="meta">{meta.join(' · ')}</p>
        <h1 class="page-title">{pub.data.title}</h1>
        <p class="authors">
          {pub.data.authors.map((a, i) => (
            <>{i > 0 ? ', ' : ''}<span class:list={['author', { me: isOwner(a) }]}>{a}</span></>
          ))}
        </p>
        <p class="venue">
          {pub.data.venue}, {yearOf(pub)}
          {pub.data.note ? <span> · {pub.data.note}</span> : null}
        </p>
        {pub.data.award && <p class="award">{pub.data.award}</p>}
        {links.length > 0 && (
          <p class="actions">
            {links.map((l) => <a href={l.href}>{l.label}</a>)}
          </p>
        )}
      </div>
    </section>

    {summary && (
      <section class="row" data-reveal>
        <h2 class="label">In short</h2>
        <p class="body">{summary}</p>
      </section>
    )}

    {keyFindings.length > 0 && (
      <section class="row" data-reveal>
        <h2 class="label">Key findings</h2>
        <ul class="findings body">
          {keyFindings.map((f) => <li>{f}</li>)}
        </ul>
      </section>
    )}

    <section class="row" data-reveal>
      <h2 class="label">Abstract</h2>
      <div class="prose"><Content /></div>
    </section>

    {figure && figSrc && (
      <section class="row" data-reveal>
        <h2 class="label">Figure</h2>
        <figure class="fig">
          <a href={figSrc}><img src={figSrc} alt={figure.alt} loading="lazy" decoding="async" /></a>
          <figcaption>{figure.caption}</figcaption>
        </figure>
      </section>
    )}

    <section class="row" data-reveal>
      <h2 class="label">Cite <button class="copy" data-copy type="button">Copy</button></h2>
      <pre id="bibtex">{bibtex}</pre>
    </section>
  </main>
</Layout>

<style>
  .label .back { margin-left: 0; }
  .meta { color: var(--muted); font-size: .9rem; margin: 0 0 .8rem; }
  .authors { margin: 1.2rem 0 .35rem; }
  .author.me { font-weight: 650; }
  .venue { margin: 0; color: var(--muted); font-size: .95rem; font-style: italic; }
  .award { margin: .6rem 0 0; color: var(--accent); }
  .actions { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin: 1.4rem 0 0; }
  .actions a { text-decoration-color: var(--muted); }
  .actions a:hover { text-decoration-color: var(--accent); }

  .findings { padding-left: 1.1rem; }
  .findings li { margin: 0 0 .5rem; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }

  /* Figures are usually drawn on white; keep a white plate in dark mode. */
  .fig { margin: 0; max-width: 42em; }
  .fig a { display: block; }
  .fig img { display: block; width: 100%; height: auto; background: #fff; padding: clamp(.5rem, 2vw, .9rem); }
  .fig figcaption { margin-top: .6rem; font-size: .9rem; line-height: 1.5; color: var(--muted); }

  .copy {
    display: block; margin: .4rem 0 0; padding: 0; font: inherit; color: var(--muted);
    background: none; border: 0; cursor: pointer; text-decoration: underline; text-decoration-color: var(--line);
  }
  .copy:hover { color: var(--ink); text-decoration-color: var(--accent); }
  #bibtex {
    margin: 0; overflow-x: auto; max-width: 100%;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: .78rem; line-height: 1.6;
    white-space: pre;
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const pre = document.getElementById('bibtex');
  btn?.addEventListener('click', async () => {
    if (!pre?.textContent) return;
    await navigator.clipboard.writeText(pre.textContent);
    const prev = btn.textContent;
    btn.textContent = 'Copied';
    setTimeout(() => (btn.textContent = prev), 1500);
  });
</script>
