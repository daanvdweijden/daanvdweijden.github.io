---
// Publications: one row per year (year as the label). Each paper shows its
// first-page thumbnail in the narrow meta column; on hover it lifts slightly
// and an accent square slides out from behind it (the same move as the
// homepage portrait), then title, authors, venue and links.
import Layout from '../../layouts/Layout.astro';
import { getPublications, groupByYear, isOwner, actionLinks, pubHref, thumbSrc } from '../../lib/pubs';

const groups = groupByYear(await getPublications());
---

<Layout title="Publications" active="publications">
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <div></div>
      <div>
        <h1 class="page-title">Publications</h1>
        <p class="page-intro">Peer-reviewed work.</p>
      </div>
    </section>

    {groups.map((g) => (
      <section class="row" data-reveal>
        <h2 class="label">{g.year}</h2>
        <ol class="list pubs">
          {g.items.map((p) => {
            const thumb = thumbSrc(p);
            return (
              <li>
                <a class="thumb" href={pubHref(p)} aria-hidden="true" tabindex="-1">
                  {thumb && <span class="block" />}
                  {thumb && <img src={thumb} alt="" loading="lazy" />}
                </a>
                <div>
                  <a class="title" href={pubHref(p)}>{p.data.title}</a>
                  <span class="sub authors">
                    {p.data.authors.map((a, i) => (
                      <>{i > 0 ? ', ' : ''}<span class:list={['author', { me: isOwner(a) }]}>{a}</span></>
                    ))}
                  </span>
                  <span class="sub venue">
                    {p.data.venue}{p.data.note ? ` · ${p.data.note}` : ''}
                  </span>
                  {p.data.award && <span class="sub award">{p.data.award}</span>}
                  {actionLinks(p).length > 0 && (
                    <span class="actions">
                      {actionLinks(p).map((l) => <a href={l.href}>{l.label}</a>)}
                    </span>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </main>
</Layout>

<style>
  .pubs > li { padding-bottom: 1.8rem; }
  .title { font-size: 1.08rem; line-height: 1.35; }
  /* Co-authors muted, my name bold in ink; the venue below is ink italic,
     so the two never run together. */
  .list .authors { color: var(--muted); margin-top: .3rem; }
  .author.me { color: var(--ink); font-weight: 650; }
  .list .venue { color: var(--ink); font-style: italic; margin-top: .25rem; }
  .award { color: var(--accent); }
  .actions { display: flex; flex-wrap: wrap; gap: .2rem 1rem; margin-top: .5rem; font-size: .9rem; }
  .list .actions a { text-decoration: underline; text-decoration-color: var(--line); }
  .list .actions a:hover { text-decoration-color: var(--accent); }

  /* Thumbnail: the covers are black and white anyway, so instead of a colour
     reveal they borrow the portrait's motion. An accent square hides behind
     the page; on hover the page lifts up-left and grows a little while the
     square slides out down-right. */
  .thumb { display: block; align-self: start; position: relative; isolation: isolate; }
  .thumb img {
    position: relative; z-index: 1;
    width: 100%; height: auto; display: block;
    outline: 1px solid var(--line);
    transition: transform .7s cubic-bezier(.22, .61, .36, 1);
  }
  .thumb .block {
    position: absolute; right: 0; bottom: 0; width: 60%; aspect-ratio: 1 / 1;
    background: var(--accent);
    transition: transform .7s cubic-bezier(.22, .61, .36, 1);
  }
  @media (hover: hover) {
    .pubs > li:hover .thumb img { transform: translate(-3%, -2%) scale(1.04); }
    .pubs > li:hover .thumb .block { transform: translate(26%, 22%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb img, .thumb .block { transition: none; }
  }
</style>
