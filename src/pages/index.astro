---
// Home. One asymmetric two-column grid: a narrow left column for the portrait
// and small labels, a wide right column where all text starts on the same
// vertical line. The single loud element is the flat colour block that the
// grayscale portrait overlaps (multiply blend), borrowed from Swiss posters.
//
// Data:
//   • profile + links  → src/site.config.ts
//   • publications     → src/content/publications
//   • news             → src/content/news/*.md
import Layout from '../layouts/Layout.astro';
import { site } from '../site.config';
import { getPublications, yearOf, pubHref } from '../lib/pubs';
import { getNews, newsHref, titleParts } from '../lib/news';
import { personLd, jsonLd } from '../lib/seo';

const base = import.meta.env.BASE_URL;
const pubs = (await getPublications()).slice(0, 4);
const news = (await getNews()).slice(0, 4);
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const iso = (d: Date) => d.toISOString().slice(0, 10);

const personJson = jsonLd({ '@context': 'https://schema.org', ...personLd(Astro.site!) });
---

<Layout description={site.description} ogType="profile">
  <script slot="head" type="application/ld+json" set:html={personJson} />

  <main class="wrap">
    <section data-reveal class="row hero">
      <figure class="portrait">
        <span class="block" aria-hidden="true"></span>
        <img src={`${base}${site.avatar}`} alt={`Portrait of ${site.name}`} width="800" height="800" />
      </figure>
      <h1 class="lede">
        I research how artificial intelligence can strengthen democracy, and
        how it can undermine it.
      </h1>
    </section>

    <section data-reveal class="row">
      <h2 class="label">Now</h2>
      <p class="body">PhD candidate at <a href={site.affiliation.url}>{site.affiliation.name}</a>, {site.university}, in the interdisciplinary <a href="https://d3-project.ch">Digital Deliberative Democracy (D3)</a> project, working on AI for citizen participation and deliberation, and on the ways it can undermine democracy. Also the <a href="https://www.ifi.uzh.ch/en/department/people/representatives.html">PhD representative</a> of the IFI department.</p>
    </section>

    <section data-reveal class="row">
      <h2 class="label">Before</h2>
      <p class="body">Linguistics (BA) and Artificial Intelligence (BSc, MSc). Member of the OEC faculty assembly until 2026, and part of the <a href="https://www.dsi.uzh.ch/en/current/news/2026/congrats-ep-2026.html">DSI PhD Excellence programme</a>.</p>
    </section>

    <section data-reveal class="row">
      <h2 class="label">Off work</h2>
      <p class="body">I run along the Limmat, swim in a Badi, and spend evenings with my fiancée and our two cats. In between: <a href={`${base}puzzles/`}>daily puzzles</a>, <a href={`${base}books/`}>books</a> and <a href={`${base}music/`}>music</a>. Always up for a new game.</p>
    </section>

    <section data-reveal class="row">
      <h2 class="label">News <a href={`${base}news/`}>All</a></h2>
      <ol class="list">
        {news.map((n) => {
          const { before, emphasis, after } = titleParts(n);
          return (
            <li>
              <time class="meta" datetime={iso(n.data.date)}>{fmtDate(n.data.date)}</time>
              <a href={newsHref(n)}>{before}{emphasis && <em class="hl">{emphasis}</em>}{after}</a>
            </li>
          );
        })}
      </ol>
    </section>

    <section data-reveal class="row">
      <h2 class="label">Publications <a href={`${base}pubs/`}>All</a></h2>
      <ol class="list">
        {pubs.map((p) => (
          <li>
            <span class="meta">{yearOf(p)}</span>
            <span>
              <a href={pubHref(p)}>{p.data.title}</a>
              {p.data.venue && <span class="sub">{p.data.venue}</span>}
            </span>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Layout>

<script>
  import { gsap } from '../lib/motion';

  // Tap to colour the portrait on touch screens (the hover state elsewhere);
  // it springs back on its own after a second. Another tap restarts the timer.
  const portrait = document.querySelector('.portrait');
  let colorTimer: ReturnType<typeof setTimeout> | undefined;
  portrait?.addEventListener('click', () => {
    if (!matchMedia('(hover: none)').matches) return;
    portrait.classList.add('is-color');
    clearTimeout(colorTimer);
    colorTimer = setTimeout(() => portrait.classList.remove('is-color'), 1000);
  });
  // Opening: the hover state played in reverse, by GSAP. The page opens with
  // photo and block pulled apart and the photo in colour; both slide home
  // together as the photo fades to gray, then hand over to the CSS hover.
  // --p is how far apart the pair is: 1 = the hover pose, 0 = home (CSS below).
  // Since the opening pose is the hover pose, hovering during the intro just
  // tweens --p back towards 1 (and leaving lets it settle), so it never jumps.
  if (portrait && document.documentElement.classList.contains('motion')) {
    const settle = () => portrait.classList.add('settled');
    const home = (delay = 0) => gsap.to(portrait, {
      '--p': 0, delay, duration: 1.4, ease: 'power3.out', overwrite: true, onComplete: settle,
    });
    gsap.set(portrait, { '--p': 1 });
    home(0.8);
    portrait.addEventListener('pointerenter', () => {
      if (portrait.classList.contains('settled')) return;
      gsap.to(portrait, { '--p': 1, duration: 0.7, ease: 'power3.out', overwrite: true });
    });
    portrait.addEventListener('pointerleave', () => {
      if (!portrait.classList.contains('settled')) home();
    });
  } else {
    portrait?.classList.add('settled');
  }
</script>

<style>
  /* Rows, labels, lists and the lede are shared styles in Layout.astro. */
  .row.hero { border-top: 0; padding: clamp(1.5rem, 5vw, 3.5rem) 0 clamp(3rem, 7vw, 5rem); align-items: end; }

  /* The portrait: a grayscale photo overlapping a flat colour block. The
     figure is its own isolated group and the photo multiplies onto it, so the
     photo takes on the colour only where it covers the block and stays plain
     gray everywhere else (in both themes). */
  .portrait {
    position: relative; isolation: isolate; margin: 0;
    aspect-ratio: 1 / 1; width: min(100%, 26rem);
  }
  .portrait img {
    position: absolute; left: 0; top: 0; width: 78%; height: 78%;
    object-fit: cover; object-position: 50% 30%;
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
    transition: filter .7s ease, transform .7s cubic-bezier(.22, .61, .36, 1);
  }
  .portrait .block {
    position: absolute; left: 38%; right: 0; top: 38%; bottom: 0;
    background: var(--accent);
    transition: transform .7s cubic-bezier(.22, .61, .36, 1);
  }
  /* Opening, driven by GSAP tweening --p from 1 to 0 (script above). It
     uses the separate `translate`/`scale` properties, so it never fights the
     hover `transform`. Until it's done (.settled), GSAP also plays the hover
     (script above), so the CSS hover and its transitions are off. */
  :global(html.motion) .portrait:not(.settled) img {
    translate: calc(var(--p, 1) * -3%) calc(var(--p, 1) * -3%);
    scale: calc(1 + var(--p, 1) * .05);
    filter: grayscale(calc(1 - var(--p, 1))) contrast(calc(1 + (1 - var(--p, 1)) * .08));
    transform: none; transition: none;
  }
  :global(html.motion) .portrait:not(.settled) .block {
    translate: calc(var(--p, 1) * 8%) calc(var(--p, 1) * 20%);
    transform: none; transition: none;
  }

  /* Hover: the photo and block pull apart (photo up-left, block down-right)
     and the photo regains its colour. Only on devices that really hover (no
     sticky state on touch). */
  @media (hover: hover) {
    .portrait:hover img { filter: none; transform: translate(-3%, -3%) scale(1.05); }
    .portrait:hover .block { transform: translate(8%, 20%); }
  }
  /* Touch screens have no hover, so a tap toggles the same state instead. */
  @media (hover: none) {
    .portrait { cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .portrait.is-color img { filter: none; transform: translate(-3%, -3%) scale(1.05); }
    .portrait.is-color .block { transform: translate(8%, 20%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait .block { transition: none; }
    .portrait img { transition: filter .7s ease; }
  }

  @media (max-width: 760px) {
    .row.hero { row-gap: 2rem; }
    .portrait { width: min(100%, 20rem); }
  }
</style>
