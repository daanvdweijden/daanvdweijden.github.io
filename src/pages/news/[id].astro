---
// A single news item's page: date, tag, and the Markdown body. One page is
// generated per file in the `news` collection.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getNews, yearOf, type NewsItem } from '../../lib/news';
import { plainText, clip } from '../../lib/text';

export async function getStaticPaths() {
  const items = await getNews();
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props {
  item: NewsItem;
}
const { item } = Astro.props;
const { Content } = await render(item);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
// Search snippet: the opening of the post, falling back to the title.
const description = clip(plainText(item.body ?? '') || item.data.title);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={item.data.title} description={description} active="news">
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <p class="label"><a class="back" href={`${import.meta.env.BASE_URL}news/`}>← All news</a></p>
      <div>
        <p class="meta">
          <time datetime={iso(item.data.date)}>{fmtDate(item.data.date)}</time>
          {item.data.tag && <span class="tag"> · {item.data.tag}</span>}
        </p>
        <h1 class="page-title">{item.data.title}</h1>
      </div>
    </section>

    <section class="row" data-reveal>
      <div></div>
      <div class="prose"><Content /></div>
    </section>
  </main>
</Layout>

<style>
  .label .back { margin-left: 0; }
  .meta { color: var(--muted); font-size: .9rem; margin: 0 0 .8rem; }
  .tag { text-transform: capitalize; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  /* Images in the body (conference photos etc.). Wrap one in a <figure> with
     a <figcaption> to get a caption; a bare ![alt](...) works too. */
  .prose :global(img) { display: block; max-width: 100%; height: auto; margin: 1.6rem 0; }
  .prose :global(figure) { margin: 1.6rem 0; }
  .prose :global(figure img) { margin: 0; }
  .prose :global(figcaption) { margin-top: .5rem; font-size: .85rem; line-height: 1.5; color: var(--muted); }
</style>
