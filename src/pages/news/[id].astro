---
// A single news item's page: date, tag, and the Markdown body. One page is
// generated per file in the `news` collection.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getNews, yearOf, type NewsItem } from '../../lib/news';
import { plainText, clip } from '../../lib/text';

export async function getStaticPaths() {
  const items = await getNews();
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props {
  item: NewsItem;
}
const { item } = Astro.props;
const { Content } = await render(item);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
// Search snippet: the opening of the post, falling back to the title.
const description = clip(plainText(item.body ?? '') || item.data.title);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={item.data.title} description={description} active="news">
  <main class="wrap">
    <!-- One grid for the whole post: date and tag on the left, title and text
         on the right. The prose box is display:contents, so its paragraphs
         land in the right column while figures can span both columns. -->
    <article class="post" data-reveal>
      <aside class="post-meta">
        <p><time datetime={iso(item.data.date)}>{fmtDate(item.data.date)}</time></p>
        {item.data.tag && <p class="tag">{item.data.tag}</p>}
        <p><a class="back" href={`${import.meta.env.BASE_URL}news/`}>← All news</a></p>
      </aside>
      <h1 class="page-title">{item.data.title}</h1>
      <div class="prose"><Content /></div>
    </article>
  </main>
</Layout>

<script>
  // Portrait photos would be enormous at full width; mark them so they sit
  // in the text column with their caption beside them instead.
  for (const img of document.querySelectorAll<HTMLImageElement>('.post figure img')) {
    const mark = () => img.closest('figure')?.classList.toggle('tall', img.naturalHeight > img.naturalWidth);
    if (img.complete) mark(); else img.addEventListener('load', mark, { once: true });
  }
</script>

<style>
  .post {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }
  .post-meta { grid-column: 1; grid-row: 1; font-size: .9rem; color: var(--muted); padding-top: .35rem; }
  .post-meta p { margin: 0 0 .15rem; }
  .post-meta .tag { text-transform: capitalize; }
  .post-meta .back { display: inline-block; margin-top: .9rem; }
  .post h1 { grid-column: 2; grid-row: 1; margin-bottom: clamp(2rem, 5vw, 3rem); }

  .prose { display: contents; }
  .prose > :global(*) { grid-column: 2; max-width: 38em; }
  .prose :global(p) { margin: 0 0 1rem; }

  /* Figures span the full grid (a subgrid, so they share its columns): the
     photo runs edge to edge, the caption sits under it in the left column. */
  .prose > :global(figure) {
    grid-column: 1 / -1; max-width: none;
    display: grid; grid-template-columns: subgrid;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(2rem, 5vw, 3rem);
  }
  .prose :global(figure img) {
    grid-column: 1 / -1; display: block; width: 100%; height: auto; margin: 0;
    max-height: 85vh; object-fit: contain; object-position: right;
  }
  .prose :global(figcaption) {
    grid-column: 1; margin-top: .6rem; font-size: .9rem; line-height: 1.5; color: var(--muted);
  }
  /* Portrait photos: in the text column, with the caption beside them,
     right-aligned against the gutter and level with the photo's bottom edge,
     so it reads as attached to the photo rather than to the page margin. */
  .prose :global(figure.tall img) { grid-column: 2; width: auto; max-width: 100%; justify-self: start; }
  .prose :global(figure.tall figcaption) {
    grid-row: 1; align-self: end; margin: 0;
    justify-self: end; max-width: 16em; text-align: right;
  }

  @media (max-width: 760px) {
    .post { grid-template-columns: 1fr; }
    .post-meta, .post h1, .prose > :global(*) { grid-column: 1; grid-row: auto; }
    .post-meta { display: flex; flex-wrap: wrap; gap: 0 .8rem; margin-bottom: .8rem; padding: 0; }
    .post-meta .back { margin-top: 0; }
    .prose :global(figure img), .prose :global(figure.tall img) { grid-column: 1; }
    .prose :global(figure.tall figcaption) { grid-row: auto; margin-top: .6rem; justify-self: start; max-width: none; text-align: left; }
  }
</style>
