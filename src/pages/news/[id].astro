---
// A single news item's page: date, tag, and the Markdown body. One page is
// generated per file in the `news` collection.
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getNews, yearOf, type NewsItem } from '../../lib/news';
import { plainText, clip } from '../../lib/text';

export async function getStaticPaths() {
  const items = await getNews();
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props {
  item: NewsItem;
}
const { item } = Astro.props;
const { Content } = await render(item);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
// Search snippet: the opening of the post, falling back to the title.
const description = clip(plainText(item.body ?? '') || item.data.title);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={item.data.title} description={description} active="news">
  <main class="wrap">
    <!-- One grid for the whole post: date and tag on the left, title and text
         on the right. The prose box is display:contents, so its paragraphs
         land in the right column while figures can span both columns. -->
    <article class="post" data-reveal>
      <aside class="post-meta">
        <p><time datetime={iso(item.data.date)}>{fmtDate(item.data.date)}</time></p>
        {item.data.tag && <p class="tag">{item.data.tag}</p>}
        <p><a class="back" href={`${import.meta.env.BASE_URL}news/`}>← All news</a></p>
      </aside>
      <h1 class="page-title">{item.data.title}</h1>
      <div class="prose"><Content /></div>
    </article>
  </main>
</Layout>

<script>
  import { gsap } from '../../lib/motion';
  import { Flip } from 'gsap/Flip';

  gsap.registerPlugin(Flip);

  // Portrait photos would be enormous at full width; mark them so they sit
  // in the text column with their caption beside them instead.
  for (const img of document.querySelectorAll<HTMLImageElement>('.post figure img')) {
    const mark = () => img.closest('figure')?.classList.toggle('tall', img.naturalHeight > img.naturalWidth);
    if (img.complete) mark(); else img.addEventListener('load', mark, { once: true });
  }

  // Click a photo to zoom it: a clone of the image is laid out at a centred
  // fit-to-screen size, and GSAP's Flip.fit makes it start exactly on top of
  // the photo in the text and fly to its place (transform only, so it stays
  // on the GPU), while the page fades behind it. Click, Esc or scroll flies
  // it back to wherever the photo is now.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DUR = reduce ? 0 : 0.45;
  let open = false;

  const zoom = (img: HTMLImageElement) => {
    if (open || !img.naturalWidth) return;
    open = true;
    const pad = Math.min(innerWidth, innerHeight) * 0.04;
    const fit = Math.min((innerWidth - 2 * pad) / img.naturalWidth, (innerHeight - 2 * pad) / img.naturalHeight);
    const w = img.naturalWidth * fit, h = img.naturalHeight * fit;

    const backdrop = document.createElement('div');
    backdrop.style.cssText = 'position:fixed;inset:0;z-index:100;cursor:zoom-out;background:color-mix(in srgb, var(--bg) 94%, transparent)';
    const big = document.createElement('img');
    big.src = img.currentSrc || img.src;
    big.alt = img.alt;
    big.style.cssText = `position:fixed;z-index:101;left:${(innerWidth - w) / 2}px;top:${(innerHeight - h) / 2}px;width:${w}px;height:${h}px;` +
      'cursor:zoom-out;pointer-events:none';
    document.body.append(backdrop, big);
    img.style.visibility = 'hidden';

    const onPhoto = () => Flip.fit(big, img, { scale: true, getVars: true }) as gsap.TweenVars;
    gsap.from(backdrop, { opacity: 0, duration: DUR, ease: 'power2.out' });
    gsap.from(big, { ...onPhoto(), duration: DUR, ease: 'power3.out' });

    let closing = false;
    const close = () => {
      if (closing) return;
      closing = true;
      removeEventListener('keydown', onKey);
      removeEventListener('scroll', close);
      removeEventListener('resize', close);
      gsap.to(backdrop, { opacity: 0, duration: DUR * 0.85, ease: 'power2.inOut' });
      gsap.to(big, {
        ...onPhoto(), duration: DUR * 0.85, ease: 'power3.inOut', overwrite: true,
        onComplete: () => {
          img.style.visibility = '';
          backdrop.remove(); big.remove();
          open = false;
        },
      });
    };
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };
    backdrop.addEventListener('click', close);
    addEventListener('keydown', onKey);
    addEventListener('resize', close);
    // Ignore the scroll events the zoom itself might cause for a moment.
    gsap.delayedCall(DUR + 0.05, () => { if (!closing) addEventListener('scroll', close, { passive: true }); });
  };

  for (const img of document.querySelectorAll<HTMLImageElement>('.post figure img')) {
    img.addEventListener('click', () => zoom(img));
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); zoom(img); }
    });
  }
</script>

<style>
  .post {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }
  .post-meta { grid-column: 1; grid-row: 1; font-size: .9rem; color: var(--muted); padding-top: .35rem; }
  .post-meta p { margin: 0 0 .15rem; }
  .post-meta .tag { text-transform: capitalize; }
  .post-meta .back { display: inline-block; margin-top: .9rem; }
  .post h1 { grid-column: 2; grid-row: 1; margin-bottom: clamp(2rem, 5vw, 3rem); }

  .prose { display: contents; }
  .prose > :global(*) { grid-column: 2; max-width: 38em; }
  .prose :global(p) { margin: 0 0 1rem; }

  /* Figures shrink-wrap their photo: the figure is exactly as wide as the
     picture (capped by the grid width and 85% of the screen height), and the
     caption sits under it starting at the photo's left edge. `contain:
     inline-size` stops a long caption from widening the figure. Landscape
     photos span the grid and sit flush right; portrait photos start at the
     text column. */
  .prose > :global(figure) {
    grid-column: 1 / -1; justify-self: end; max-width: 100%;
    width: fit-content; display: flex; flex-direction: column;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 clamp(2rem, 5vw, 3rem);
  }
  .prose :global(figure img) {
    display: block; width: auto; height: auto; max-width: 100%; max-height: 85vh; margin: 0; cursor: zoom-in;
  }
  .prose :global(figcaption) {
    contain: inline-size; margin-top: .6rem;
    font-size: .9rem; line-height: 1.5; color: var(--muted);
  }
  .prose > :global(figure.tall) { grid-column: 2; justify-self: start; }

  @media (max-width: 760px) {
    .post { grid-template-columns: 1fr; }
    .post-meta, .post h1, .prose > :global(*), .prose > :global(figure.tall) { grid-column: 1; grid-row: auto; }
    .post-meta { display: flex; flex-wrap: wrap; gap: 0 .8rem; margin-bottom: .8rem; padding: 0; }
    .post-meta .back { margin-top: 0; }
    .prose > :global(figure) { justify-self: start; }
  }
</style>
