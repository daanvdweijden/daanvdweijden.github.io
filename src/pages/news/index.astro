---
// News: one row per year (year as the label), each item with its date and
// tag in the meta column and a short preview under the title. Data comes from
// the `news` collection.
import Layout from '../../layouts/Layout.astro';
import Feature from '../../components/Feature.astro';
import { excerpt, firstImage, getNews, groupByYear, LEAD_DAYS, newsHref, titleParts } from '../../lib/news';

// The newest item leads the page while it is fresh (LEAD_DAYS at build time);
// after that everything is just the list.
const all = await getNews();
const lead = all[0] && Date.now() - all[0].data.date.valueOf() < LEAD_DAYS * 864e5 ? all[0] : undefined;
const groups = groupByYear(all.filter((n) => n !== lead));
const leadParts = lead && titleParts(lead);
const leadImg = lead && firstImage(lead);
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title="News" active="news">
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <div></div>
      <div>
        <h1 class="page-title">News</h1>
        <p class="page-intro">Talks, awards, and other announcements.</p>
      </div>
    </section>

    {lead && leadParts && (
      <Feature href={newsHref(lead)} img={leadImg?.src} alt={leadImg?.alt}>
        <span class="f-meta">
          <time datetime={iso(lead.data.date)}>{fmtDate(lead.data.date)}</time>{lead.data.tag && <> · <span class="tag-inline">{lead.data.tag}</span></>}
        </span>
        <a class="f-title" href={newsHref(lead)}>{leadParts.before}{leadParts.emphasis && <em class="hl">{leadParts.emphasis}</em>}{leadParts.after}</a>
        <p class="f-text">{excerpt(lead, 340)}</p>
        <a class="f-more" href={newsHref(lead)}>Read more</a>
      </Feature>
    )}

    {groups.map((g) => (
      <section class="row" data-reveal>
        <h2 class="label">{g.year}</h2>
        <ol class="list news">
          {g.items.map((n) => {
            const { before, emphasis, after } = titleParts(n);
            const preview = excerpt(n, 160);
            return (
              <li>
                <span class="meta">
                  <time datetime={iso(n.data.date)}>{fmtDate(n.data.date)}</time>
                  {n.data.tag && <span class="tag">{n.data.tag}</span>}
                </span>
                <div>
                  <a class="title" href={newsHref(n)}>{before}{emphasis && <em class="hl">{emphasis}</em>}{after}</a>
                  {preview && <span class="sub">{preview}</span>}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </main>
</Layout>

<style>
  .news > li { padding-bottom: 1.4rem; }
  .title { font-size: 1.08rem; }
  .tag { display: block; }
  .tag::first-letter, .tag-inline::first-letter { text-transform: uppercase; }
  .tag-inline { display: inline-block; }
  /* Previews always take exactly two lines, so items stack evenly. */
  .sub {
    line-height: 1.5; margin-top: .3rem; max-width: 36em;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2;
    overflow: hidden; min-height: 3em;
  }
</style>
