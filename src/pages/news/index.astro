---
// News: one row per year (year as the label), each item with its date and
// tag in the meta column and a short preview under the title. Data comes from
// the `news` collection.
import Layout from '../../layouts/Layout.astro';
import { excerpt, getNews, groupByYear, newsHref, titleParts } from '../../lib/news';

const groups = groupByYear(await getNews());
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title="News" active="news">
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <div></div>
      <div>
        <h1 class="page-title">News</h1>
        <p class="page-intro">Talks, awards, and other announcements.</p>
      </div>
    </section>

    {groups.map((g) => (
      <section class="row" data-reveal>
        <h2 class="label">{g.year}</h2>
        <ol class="list news">
          {g.items.map((n) => {
            const { before, emphasis, after } = titleParts(n);
            const preview = excerpt(n, 160);
            return (
              <li>
                <span class="meta">
                  <time datetime={iso(n.data.date)}>{fmtDate(n.data.date)}</time>
                  {n.data.tag && <span class="tag">{n.data.tag}</span>}
                </span>
                <div>
                  <a class="title" href={newsHref(n)}>{before}{emphasis && <em class="hl">{emphasis}</em>}{after}</a>
                  {preview && <span class="sub">{preview}</span>}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </main>
</Layout>

<style>
  .news > li { padding-bottom: 1.4rem; }
  .title { font-size: 1.08rem; }
  .tag { display: block; }
  .tag::first-letter { text-transform: uppercase; }
  /* Previews always take exactly two lines, so items stack evenly. */
  .sub {
    line-height: 1.5; margin-top: .3rem; max-width: 36em;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2;
    overflow: hidden; min-height: 3em;
  }
</style>
