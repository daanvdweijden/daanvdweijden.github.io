---
// Listening log. Same row grid as the rest of the site: two stat rows, three
// ranked lists for the last 30 days, then the cover grids. Covers sit in
// grayscale and take on their colour on hover, an echo of the homepage portrait.
import Layout from '../../layouts/Layout.astro';
import { getMusicData } from '../../lib/music';

const { albums, recentAlbums, topAlbums30d, topArtists30d, topTracks30d, stats, stats30d } = await getMusicData();

// format helpers
const fmt = (n: number) => n.toLocaleString('en-US');
const statHours = (ms: number) => fmt(Math.round(ms / 3_600_000));

// per-album time, shown in the tooltip
const albumHours = (ms: number) => {
  const h = ms / 3_600_000;
  return h >= 10 ? `${Math.round(h)} hrs` : `${h.toFixed(1)} hrs`;
};

const link = (kind: 'album' | 'artist' | 'track', item: { id: string | number; spotifyId?: string | null }) =>
  item.spotifyId ? `https://open.spotify.com/${kind}/${item.spotifyId}` : `https://stats.fm/${kind}/${item.id}`;

// The three 30-day lists share one layout: the #1 with its cover, the rest as a ranked list.
const top30 = [
  {
    label: 'Top albums',
    alt: 'Cover of',
    items: topAlbums30d.map((a) => ({ ...a, sub: a.artist, href: link('album', a) })),
  },
  {
    label: 'Top artists',
    alt: 'Photo of',
    items: topArtists30d.map((a) => ({ ...a, sub: '', href: link('artist', a) })),
  },
  {
    label: 'Top songs',
    alt: 'Cover of',
    items: topTracks30d.map((t) => ({ ...t, sub: t.artist, href: link('track', t) })),
  },
];

const grids = [
  { label: 'Most played, past year', items: recentAlbums, eager: 8, empty: 'Not enough recent listening data yet.' },
  { label: 'Top albums, all time', items: albums, eager: 0, empty: "Couldn't reach stats.fm right now — check back later." },
];
---

<Layout title="Listening log" description="The music I've spent my life listening to, from stats.fm." noindex>
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <p class="label">Off the clock</p>
      <div>
        <h1 class="page-title">Listening log</h1>
        <p class="page-intro">
          What I've had on repeat lately, and the records I've played most over a lifetime.
        </p>
      </div>
    </section>

    {stats && (
      <section class="row" data-reveal>
        <h2 class="label">All time</h2>
        <dl class="stats">
          <div><dt>Hours listened</dt><dd>{statHours(stats.durationMs)}</dd></div>
          <div><dt>Streams</dt><dd>{fmt(stats.streams)}</dd></div>
          <div><dt>Artists</dt><dd>{fmt(stats.uniqueArtists)}</dd></div>
          <div><dt>Albums</dt><dd>{fmt(stats.uniqueAlbums)}</dd></div>
        </dl>
      </section>
    )}

    {stats30d && (
      <section class="row" data-reveal>
        <h2 class="label">Last 30 days</h2>
        <dl class="stats">
          <div><dt>Hours listened</dt><dd>{statHours(stats30d.durationMs)}</dd></div>
          <div><dt>Streams</dt><dd>{fmt(stats30d.streams)}</dd></div>
          <div><dt>Artists</dt><dd>{fmt(stats30d.uniqueArtists)}</dd></div>
          <div><dt>Albums</dt><dd>{fmt(stats30d.uniqueAlbums)}</dd></div>
        </dl>
      </section>
    )}

    {top30.map(({ label, alt, items }) => (
      <section class="row" data-reveal>
        <h2 class="label">{label}<span class="when">Last 30 days</span></h2>
        {items.length ? (
          <div class="ranked">
            {items.slice(0, 1).map((item) => (
              <a class="feature" href={item.href} target="_blank" rel="noopener noreferrer">
                <span class="feature-cover">
                  {item.imageUrl ? (
                    <img src={item.imageUrl} alt={`${alt} ${item.name}`} loading="eager" />
                  ) : (
                    <span class="no-cover"><span>{item.name}</span></span>
                  )}
                </span>
                <span class="feature-meta">
                  <span class="feature-rank">1</span>
                  <span class="feature-title">{item.name}</span>
                  {item.sub && <span class="feature-sub">{item.sub}</span>}
                  <span class="feature-sub">{fmt(item.streams)} plays · {albumHours(item.playedMs)}</span>
                </span>
              </a>
            ))}
            <ol class="rank-list" role="list">
              {items.slice(1).map((item) => (
                <li>
                  <span class="rank-num">{item.position}</span>
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    <span class="rank-title">{item.name}</span>
                    {item.sub && <span class="rank-sub">{item.sub}</span>}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ) : (
          <p class="empty">Not enough recent listening data yet.</p>
        )}
      </section>
    ))}

    {grids.map(({ label, items, eager, empty }) => (
      <section class="row" data-reveal>
        <h2 class="label">{label}</h2>
        {items.length ? (
          <div class="album-grid">
            {items.map((album, index) => (
              <a
                class="album-card"
                href={link('album', album)}
                target="_blank"
                rel="noopener noreferrer"
                data-title={album.name}
                data-artist={album.artist}
                data-streams={fmt(album.streams)}
                data-hours={albumHours(album.playedMs)}
                data-year={album.releaseYear ?? ''}
              >
                <span class="cover">
                  {album.imageUrl ? (
                    <img src={album.imageUrl} alt={`Cover of ${album.name}`} loading={index < eager ? 'eager' : 'lazy'} />
                  ) : (
                    <span class="no-cover"><span>{album.name}</span></span>
                  )}
                </span>
                <span class="album-rank">{album.position}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">{empty}</p>
        )}
      </section>
    ))}

    <div id="album-tip" class="tip" role="tooltip">
      <p id="tip-title" class="tip-title">Title</p>
      <p id="tip-artist" class="tip-sub">Artist</p>
      <p id="tip-meta" class="tip-meta"></p>
    </div>
  </main>
</Layout>

<script>
  const tip = document.getElementById('album-tip');
  const tipTitle = document.getElementById('tip-title');
  const tipArtist = document.getElementById('tip-artist');
  const tipMeta = document.getElementById('tip-meta');

  if (tip && tipTitle && tipArtist && tipMeta) {
    const show = (el: Element) => {
      const d = (el as HTMLElement).dataset;
      tipTitle.textContent = d.title || '';
      tipArtist.textContent = d.artist || '';

      const bits: string[] = [];
      if (d.hours) bits.push(d.hours);
      if (d.streams) bits.push(`${d.streams} plays`);
      if (d.year) bits.push(d.year);
      tipMeta.textContent = bits.join(' · ');

      tip.style.opacity = '1';

      const r = el.getBoundingClientRect();
      const tw = tip.offsetWidth;
      let left = r.left + r.width / 2 - tw / 2;
      left = Math.max(16, Math.min(left, window.innerWidth - tw - 16));
      tip.style.left = left + 'px';

      let top = window.scrollY + r.top - tip.offsetHeight - 12;
      if (r.top - tip.offsetHeight - 12 < 0) {
        top = window.scrollY + r.bottom + 12;
      }
      tip.style.top = top + 'px';
    };

    const hide = () => { tip.style.opacity = '0'; };

    document.addEventListener('mouseover', (e) => {
      const target = (e.target as Element).closest('.album-card');
      if (target) show(target);
    });
    document.addEventListener('mouseout', (e) => {
      const target = (e.target as Element).closest('.album-card');
      if (target) hide();
    });
    document.addEventListener('focusin', (e) => {
      const target = (e.target as Element).closest('.album-card');
      if (target) show(target);
    });
    document.addEventListener('focusout', hide);
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>

<style>
  /* Rows, labels and the page head are shared styles in Layout.astro. */

  /* ---- stats: big numbers, small captions, no boxes ---- */
  .stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2rem 2rem;
    margin: 0; max-width: 42em;
  }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .stats dd {
    margin: 0; font-size: 2.2rem; font-weight: 400; line-height: 1.1;
    letter-spacing: -.02em; font-variant-numeric: tabular-nums;
  }
  .stats dt { color: var(--muted); font-size: .9rem; margin-top: .3rem; }

  .when { display: block; }
  .empty { color: var(--muted); margin: 0; }

  /* ---- covers: grayscale until hovered ---- */
  .feature-cover, .cover {
    display: block; position: relative; aspect-ratio: 1 / 1;
    overflow: hidden; background: var(--line);
  }
  .feature-cover img, .cover img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.05); transition: filter .4s ease;
  }
  .feature:hover img, .feature:focus-visible img,
  .album-card:hover img, .album-card:focus-visible img { filter: none; }

  .no-cover {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    padding: .5rem; text-align: center;
  }
  .no-cover span {
    font-size: .72rem; line-height: 1.2; color: var(--ink);
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* ---- 30-day lists: the #1 with its cover, then a plain ranked list ---- */
  .ranked { max-width: 42em; }
  .feature {
    display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1.2rem;
    align-items: end; text-decoration: none; margin-bottom: 1.2rem;
  }
  .feature-meta { display: flex; flex-direction: column; min-width: 0; }
  .feature-rank { color: var(--muted); font-size: .9rem; font-variant-numeric: tabular-nums; }
  .feature-title { font-size: clamp(1.2rem, 2.2vw, 1.5rem); line-height: 1.2; letter-spacing: -.01em; margin-top: .2rem; }
  .feature:hover .feature-title { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1px; }
  .feature-sub { color: var(--muted); font-size: .9rem; margin-top: .15rem; }

  .rank-list { list-style: none; margin: 0; padding: 0; }
  .rank-list li {
    display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .5rem;
    padding: .25rem 0 .45rem;
  }
  .rank-num { color: var(--muted); font-size: .9rem; padding-top: .1rem; font-variant-numeric: tabular-nums; }
  .rank-list a { text-decoration: none; min-width: 0; }
  .rank-list a:hover .rank-title { text-decoration: underline; text-decoration-color: var(--accent); }
  .rank-sub { color: var(--muted); font-size: .9rem; margin-left: .5rem; }

  /* ---- cover grids ---- */
  .album-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
    gap: 1rem .9rem;
  }
  .album-card { display: block; text-decoration: none; }
  .album-card:focus-visible { outline: none; }
  .album-card:focus-visible .cover { outline: 2px solid var(--ink); outline-offset: 3px; }
  .album-rank {
    display: block; margin-top: .3rem;
    color: var(--muted); font-size: .8rem; font-variant-numeric: tabular-nums;
  }

  /* ---- tooltip: flat paper slip with a hairline ---- */
  .tip {
    position: absolute; z-index: 60; pointer-events: none;
    background: var(--bg); color: var(--ink);
    border: 1px solid var(--line);
    padding: .8rem 1rem; width: max-content; max-width: 18rem;
    opacity: 0; transition: opacity .15s ease;
  }
  .tip p { margin: 0; }
  .tip-title { font-size: 1rem; line-height: 1.25; }
  .tip-sub { color: var(--muted); font-size: .85rem; margin-top: .2rem !important; }
  .tip-meta {
    color: var(--muted); font-size: .8rem;
    border-top: 1px solid var(--line); margin-top: .6rem !important; padding-top: .5rem;
  }

  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .when { display: inline; margin-left: .6rem; }
    .feature { grid-template-columns: 6rem minmax(0, 1fr); gap: 1rem; }
    .album-grid { grid-template-columns: repeat(auto-fill, minmax(4.75rem, 1fr)); gap: .9rem .7rem; }
  }
</style>
