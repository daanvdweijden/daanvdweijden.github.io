---
// CV — an overview, not the whole record. The full account lives in the PDF,
// built from the LaTeX source at github.com/daanvdweijden/cv, which is the
// source of truth. That repo's CI commits public/cv/daan-van-der-weijden-cv.pdf
// here on every change, so the download below stays current on its own; this
// page carries the sections a visitor wants at a glance and links out for the
// rest.
// Content comes from src/data/resume.json (JSON Resume schema, plus custom
// sections it has no slot for). The JSON deliberately holds more than is shown
// — presentations, supervision, visits and languages are kept in sync with the
// PDF, so restoring a section here is a matter of adding it to `sections`.
import Layout from '../../layouts/Layout.astro';
import {
  resume, educationSorted, workSorted, awardsSorted, presentationsSorted,
  supervisionSorted, teachingSorted, visitsSorted, volunteerSorted,
  dateRange, formatDate, countryName,
} from '../../lib/resume';

const sections = [
  {
    key: 'education',
    label: 'Education',
    items: educationSorted().map((e) => ({
      when: dateRange(e.startDate, e.endDate),
      title: `${e.studyType} in ${e.area}`,
      org: e.institution,
      detail: [e.score, e.summary].filter(Boolean).join(' · '),
      note: e.thesis ? `Thesis: ${e.thesis}${e.thesisNote ? ` — ${e.thesisNote}` : ''}` : undefined,
    })),
  },
  {
    key: 'awards',
    label: 'Awards and grants',
    items: awardsSorted().map((a) => ({
      when: formatDate(a.date),
      title: a.title,
      org: a.awarder,
      detail: a.summary,
    })),
  },
  {
    key: 'teaching',
    label: 'Teaching',
    items: teachingSorted().map((t) => ({
      when: t.term,
      title: t.course,
      org: [t.role, t.detail, t.institution].filter(Boolean).join(', '),
    })),
  },
  {
    key: 'work',
    label: 'Research and work',
    items: workSorted().map((w) => ({
      when: dateRange(w.startDate, w.endDate),
      title: w.position,
      org: [w.name, w.location].filter(Boolean).join(', '),
      detail: w.summary,
    })),
  },
  {
    key: 'service',
    label: 'Service',
    items: volunteerSorted().map((v) => ({
      when: v.term,
      title: v.position,
      org: v.organization,
      detail: v.summary,
    })),
  },
];


---

<Layout title="CV" active="cv">
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <p class="label">CV</p>
      <div>
        <h1 class="page-title">Education, teaching and service, at a glance.</h1>
        <p class="page-intro">
          The full CV, including publications, talks and student supervision, is in the <a href={`${import.meta.env.BASE_URL}cv/daan-van-der-weijden-cv.pdf`}>PDF</a>.
        </p>
      </div>
    </section>

    {sections.map((s) => (
      <section class="row" data-reveal>
        <h2 class="label">{s.label}</h2>
        <ol class="list cv">
          {s.items.map((item) => (
            <li>
              <span class="meta">{item.when}</span>
              <div>
                {item.title && <span class="title">{item.title}</span>}
                {item.org && <span class="sub">{item.org}</span>}
                {item.detail && <span class="sub">{item.detail}</span>}
                {item.note && <span class="sub">{item.note}</span>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Layout>

<style>
  .page-intro a { color: var(--ink); text-decoration-color: var(--accent); }
  .cv > li { grid-template-columns: 9rem minmax(0, 1fr); padding-bottom: 1.2rem; }
  .title { display: block; }
  @media (max-width: 520px) {
    .cv > li { grid-template-columns: 1fr; gap: .1rem; }
  }
</style>
