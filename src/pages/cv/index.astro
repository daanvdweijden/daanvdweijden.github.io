---
// CV — an overview, not the whole record. The full account lives in the PDF,
// built from the LaTeX source at github.com/daanvdweijden/cv, which is the
// source of truth. That repo's CI commits public/cv/daan-van-der-weijden-cv.pdf
// here on every change, so the download below stays current on its own; this
// page carries the sections a visitor wants at a glance and links out for the
// rest.
// Content comes from src/data/resume.json (JSON Resume schema, plus custom
// sections it has no slot for). The JSON deliberately holds more than is shown
// — presentations, supervision, visits and languages are kept in sync with the
// PDF, so restoring a section here is a matter of adding it to `sections`.
import Layout from '../../layouts/Layout.astro';
import {
  resume, educationSorted, workSorted, awardsSorted, presentationsSorted,
  supervisionSorted, teachingSorted, visitsSorted, volunteerSorted,
  dateRange, formatDate, countryName,
} from '../../lib/resume';

const sections = [
  {
    key: 'education',
    label: 'Education',
    items: educationSorted().map((e) => ({
      when: dateRange(e.startDate, e.endDate),
      title: `${e.studyType} in ${e.area}`,
      org: e.institution,
      detail: [e.score, e.summary].filter(Boolean).join(' · '),
      note: e.thesis ? `Thesis: ${e.thesis}${e.thesisNote ? ` — ${e.thesisNote}` : ''}` : undefined,
    })),
  },
  {
    key: 'awards',
    label: 'Awards & Grants',
    items: awardsSorted().map((a) => ({
      when: formatDate(a.date),
      title: a.title,
      org: a.awarder,
      detail: a.summary,
    })),
  },
  {
    key: 'teaching',
    label: 'Teaching',
    items: teachingSorted().map((t) => ({
      when: t.term,
      title: t.course,
      org: [t.role, t.detail, t.institution].filter(Boolean).join(', '),
    })),
  },
  {
    key: 'work',
    label: 'Research & Professional Experience',
    items: workSorted().map((w) => ({
      when: dateRange(w.startDate, w.endDate),
      title: w.position,
      org: [w.name, w.location].filter(Boolean).join(', '),
      detail: w.summary,
    })),
  },
  {
    key: 'service',
    label: 'Academic Service & Engagement',
    items: volunteerSorted().map((v) => ({
      when: v.term,
      title: v.position,
      org: v.organization,
      detail: v.summary,
    })),
  },
];


---

<Layout title="CV" active="cv">
  <main class="wrap page">
    <header class="page-head">
      <p class="eyebrow">Experience</p>
      <h1>Curriculum Vitae</h1>
      <p class="lede">
        An overview of my education, teaching, and service. The full CV —
        including publications, talks, and student supervision — is in the PDF.
      </p>
      <a class="cv-download" href={`${import.meta.env.BASE_URL}cv/daan-van-der-weijden-cv.pdf`}>
        Download CV (PDF)
      </a>
    </header>

    {sections.map((s) => (
      <section class="cv-section">
        <h2 class="section-title">{s.label}</h2>
        <ol class="entries">
          {s.items.map((item) => (
            <li class="entry">
              <div class="when">{item.when}</div>
              <div class="body">
                {item.title && <h3 class="entry-title">{item.title}</h3>}
                {item.org && <p class="org">{item.org}</p>}
                {item.detail && <p class="detail">{item.detail}</p>}
                {item.note && <p class="note">{item.note}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</Layout>

<style>
  /* Only set vertical padding -- the `padding` shorthand would zero out the
     horizontal padding `.wrap` provides, pulling content outside the header. */
  .page { padding-top: clamp(2.5rem, 7vw, 5rem); padding-bottom: clamp(3rem, 8vw, 6rem); }

  .page-head { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  /* Accent dot echoes the homepage kicker index (CV = red, the personal card). */
  .eyebrow {
    display: inline-flex; align-items: center; gap: .5rem;
    font-family: var(--mono); font-size: .72rem; text-transform: uppercase;
    letter-spacing: .14em; color: var(--muted); margin: 0 0 1rem;
  }
  .eyebrow::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%; flex: none;
    background: var(--p-red-fg);
  }
  .page-head h1 {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 3.4rem); letter-spacing: -0.025em; line-height: 1.05; margin: 0;
  }
  .lede { margin: 1rem 0 0; max-width: 52ch; color: var(--muted); }

  /* Hairline button, matching the profile links on the home page. */
  .cv-download {
    display: inline-block; margin-top: 1.4rem;
    font-family: var(--mono); font-size: .72rem; text-transform: uppercase;
    letter-spacing: .1em; text-decoration: none; color: var(--ink);
    border: 1px solid var(--line); border-radius: 2px;
    padding: .55rem .9rem; transition: border-color .15s ease;
  }
  .cv-download:hover { border-color: var(--ink); }

  .cv-section { padding: clamp(1.5rem, 4vw, 2.5rem) 0; border-top: 1px solid var(--line); }
  .section-title {
    font-family: var(--serif); font-weight: 500; font-size: 1.6rem;
    letter-spacing: -0.02em; margin: 0 0 1.5rem;
  }

  .entries { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(1.4rem, 3vw, 2rem); }
  .entry {
    display: grid; grid-template-columns: 9rem 1fr; gap: clamp(1rem, 3vw, 2.5rem);
  }
  .when {
    font-family: var(--mono); font-size: .72rem; text-transform: uppercase;
    letter-spacing: .05em; color: var(--muted); padding-top: .2rem;
  }

  .entry-title {
    font-family: var(--serif); font-weight: 500; font-size: 1.1rem;
    letter-spacing: -0.01em; margin: 0 0 .3rem;
  }
  .org { margin: 0 0 .3rem; font-size: .95rem; color: var(--ink); }
  .detail { margin: 0 0 .3rem; font-size: .92rem; color: var(--muted); }
  .note { margin: 0; font-size: .85rem; color: var(--muted); font-style: italic; }

  @media (max-width: 680px) {
    .entry { grid-template-columns: 1fr; gap: .4rem; }
  }
</style>
