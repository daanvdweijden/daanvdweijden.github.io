---
// Reading log. Same row grid as the rest of the site: stats, the review panel,
// then one row per year with that year's covers. Covers sit in grayscale and
// take on their colour on hover, an echo of the homepage portrait.
import Layout from '../../layouts/Layout.astro';
import { getReadBooks, type Book } from '../../lib/books';

const books = await getReadBooks();
const total = books.length;

// calculate some stats
const ratings = books.filter((b) => b.rating > 0).map((b) => b.rating);
const avgRating = ratings.length ? (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(1) : '0';

const yearOf = (b: Book) => new Date(b.readAt || b.addedAt).getFullYear();
const currentYear = new Date().getFullYear();
const readThisYear = books.filter((b) => (b.readAt || b.addedAt) && yearOf(b) === currentYear).length;
const fiveStarReads = books.filter((b) => b.rating === 5).length;

const latestReview = books.find((b) => b.review && b.review.trim().length > 0) || null;

// Books arrive newest first; group consecutive runs by year, one row each.
const years: { year: number; books: Book[] }[] = [];
for (const book of books) {
  const year = yearOf(book);
  const last = years[years.length - 1];
  if (last && last.year === year) last.books.push(book);
  else years.push({ year, books: [book] });
}

// format date helper
const formatDate = (dateStr: string | null) => {
  if (!dateStr) return 'Unknown';
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
const stars = (n: number) => (n > 0 ? `${'★'.repeat(n)}${'☆'.repeat(5 - n)}` : '');

let coverIndex = 0;
---

<Layout title="Reading log" description="A log of books I've read." noindex>
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <div></div>
      <div>
        <h1 class="page-title">Reading log</h1>
        <p class="page-intro">
          A running list of books I've read, fetched straight from my Goodreads. Reviews are in Dutch only.
        </p>
      </div>
    </section>

    <section class="row" data-reveal>
      <h2 class="label">In numbers</h2>
      <dl class="stats">
        <div><dt>Books</dt><dd>{total}</dd></div>
        <div><dt>Read in {currentYear}</dt><dd>{readThisYear}</dd></div>
        <div><dt>Five-star reads</dt><dd>{fiveStarReads}</dd></div>
        <div><dt>Average rating</dt><dd>{avgRating}</dd></div>
      </dl>
    </section>

    {latestReview && (
      <section class="row review" id="review-section" tabindex="-1" data-reveal>
        <h2 class="label" id="review-kicker">Latest review</h2>
        <div class="review-content">
          <div class="review-cover" id="review-cover">
            {latestReview.imageUrl ? (
              <img src={latestReview.imageUrl} alt={`Cover of ${latestReview.title}`} />
            ) : (
              <div class="no-cover">
                <span class="no-cover-title">{latestReview.title}</span>
              </div>
            )}
          </div>
          <div class="review-details">
            <h3 class="review-title" id="review-title">{latestReview.title}</h3>
            <p class="review-author" id="review-author">by {latestReview.author}</p>
            <p class="review-meta">
              <span class="review-rating" id="review-rating" aria-label={`${latestReview.rating} out of 5 stars`}>
                {stars(latestReview.rating)}
              </span>
              <span id="review-date">Finished {formatDate(latestReview.readAt || latestReview.addedAt)}</span>
            </p>
            <div class="review-text" id="review-text" set:html={latestReview.reviewHtml} />
          </div>
        </div>
      </section>
    )}

    {years.map(({ year, books: yearBooks }) => (
      <section class="row" data-reveal>
        <h2 class="label">{year}<span class="count">{yearBooks.length} {yearBooks.length === 1 ? 'book' : 'books'}</span></h2>
        <div class="book-grid">
          {yearBooks.map((book) => {
            const index = coverIndex++;
            return (
              <div
                class="book-card"
                tabindex="0"
                role="button"
                aria-label={`Show my review of ${book.title}`}
                data-title={book.title}
                data-author={book.author}
                data-rating={book.rating}
                data-date={formatDate(book.readAt || book.addedAt)}
                data-review-html={book.reviewHtml}
                data-image={book.imageUrl}
              >
                {book.imageUrl ? (
                  <img src={book.imageUrl} alt={`Cover of ${book.title}`} loading={index < 8 ? 'eager' : 'lazy'} />
                ) : (
                  <div class="no-cover">
                    <span class="no-cover-title">{book.title}</span>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <div id="book-tip" class="tip" role="tooltip">
      <p id="tip-title" class="tip-title">Title</p>
      <p id="tip-author" class="tip-sub">Author</p>
      <p class="tip-sub"><span id="tip-rating" class="tip-rating"></span> <span id="tip-date">Date</span></p>
      <p id="tip-hint" class="tip-hint">Click to read the review</p>
    </div>
  </main>
</Layout>

<script>
  const tip = document.getElementById('book-tip');
  const tipTitle = document.getElementById('tip-title');
  const tipAuthor = document.getElementById('tip-author');
  const tipDate = document.getElementById('tip-date');
  const tipRating = document.getElementById('tip-rating');
  const tipHint = document.getElementById('tip-hint');

  if (tip && tipTitle && tipAuthor && tipDate && tipRating && tipHint) {
    const show = (el: Element) => {
      const data = (el as HTMLElement).dataset;

      tipTitle.textContent = data.title || '';
      tipAuthor.textContent = `by ${data.author || ''}`;
      tipDate.textContent = `Finished ${data.date || ''}`;

      const rating = parseInt(data.rating || '0', 10);
      tipRating.textContent = rating > 0 ? '★'.repeat(rating) : '';

      // The review itself lives in the review row — the tip just says
      // whether there's one to open.
      tipHint.textContent = data.reviewHtml ? 'Click to read the review' : 'No review for this one';

      // Stays pointer-events: none (as the stylesheet has it): the tip is
      // parked right over the cover it describes, and anything clickable here
      // would swallow the click that opens the review.
      tip.style.opacity = '1';

      const r = el.getBoundingClientRect();
      const tw = tip.offsetWidth;
      let left = r.left + r.width / 2 - tw / 2;
      left = Math.max(16, Math.min(left, window.innerWidth - tw - 16));
      tip.style.left = left + 'px';

      // try placing above
      let top = window.scrollY + r.top - tip.offsetHeight - 12;
      // if too high, place below
      if (r.top - tip.offsetHeight - 12 < 0) {
        top = window.scrollY + r.bottom + 12;
      }
      tip.style.top = top + 'px';
    };

    const hide = () => {
      tip.style.opacity = '0';
    };

    let hideTimeout: number;

    const startHide = () => {
      clearTimeout(hideTimeout);
      hideTimeout = window.setTimeout(hide, 250);
    };

    document.addEventListener('mouseover', (e) => {
      const target = (e.target as Element).closest('.book-card');
      if (target) {
        clearTimeout(hideTimeout);
        show(target);
      } else {
        startHide();
      }
    });

    document.addEventListener('focusin', (e) => {
      const target = (e.target as Element).closest('.book-card');
      if (target) show(target);
    });
    document.addEventListener('focusout', hide);
  }
</script>

<script>
  import { ScrollSmoother } from 'gsap/ScrollSmoother';
  import { gsap, reduceMotion } from '../../lib/motion';

  // Clicking a cover swaps the review row from "latest review" to that book's.
  // Everything it needs already rides along on the card's data attributes, so
  // there's no second fetch and no per-book page.
  //
  // The swap is one movement: the page glides up to the review while a copy
  // of the clicked cover flies from the grid into the review's cover slot.
  // The old text fades out, the row eases to its new height, and the new text
  // settles in line by line as the scroll lands.
  const section = document.getElementById('review-section');
  const kicker = document.getElementById('review-kicker');
  const cover = document.getElementById('review-cover');
  const title = document.getElementById('review-title');
  const author = document.getElementById('review-author');
  const rating = document.getElementById('review-rating');
  const date = document.getElementById('review-date');
  const text = document.getElementById('review-text');
  const details = section?.querySelector<HTMLElement>('.review-details');

  if (section && kicker && cover && title && author && rating && date && text && details) {
    let selected: Element | null = null;
    let running: gsap.core.Timeline | null = null;
    let resizing: gsap.core.Tween | null = null;

    // Put the card's book into the review row (no animation).
    const fill = (data: DOMStringMap) => {
      kicker.textContent = 'Selected review';
      title.textContent = data.title || '';
      author.textContent = `by ${data.author || ''}`;
      date.textContent = `Finished ${data.date || ''}`;

      const stars = parseInt(data.rating || '0', 10);
      rating.textContent = stars > 0 ? '★'.repeat(stars) + '☆'.repeat(5 - stars) : '';
      rating.setAttribute('aria-label', stars > 0 ? `${stars} out of 5 stars` : '');

      // Already sanitized to an allowlist at build time (see lib/books.ts), so
      // the markup — paragraph breaks, links, blockquotes — survives intact.
      const html = data.reviewHtml || '';
      text.innerHTML = html;
      if (!html) {
        text.textContent = "I didn't write a review for this one.";
        text.classList.add('is-empty');
      } else {
        text.classList.remove('is-empty');
      }

      if (data.image) {
        cover.innerHTML = '';
        const img = document.createElement('img');
        img.src = data.image;
        img.alt = `Cover of ${data.title || ''}`;
        cover.appendChild(img);
      } else {
        cover.innerHTML = '<div class="no-cover"><span class="no-cover-title"></span></div>';
        cover.querySelector('.no-cover-title')!.textContent = data.title || '';
      }
    };

    // The page's scroll position, through ScrollSmoother when it's on (its
    // scrollTop moves content and scrollbar together, with no extra lag).
    const scroller = () => {
      const smoother = ScrollSmoother.get();
      return {
        get: () => (smoother ? smoother.scrollTop() : scrollY),
        set: (y: number) => (smoother ? smoother.scrollTop(y) : scrollTo(0, y)),
      };
    };
    const targetY = () => {
      const smoother = ScrollSmoother.get();
      if (smoother) return smoother.offset(section, 'top top');
      const max = document.documentElement.scrollHeight - innerHeight;
      return Math.min(max, Math.max(0, section.getBoundingClientRect().top + scrollY - 16));
    };

    const select = (card: HTMLElement) => {
      // A second click mid-flight: finish the first one at once.
      running?.progress(1);
      resizing?.progress(1);

      selected?.classList.remove('is-selected');
      card.classList.add('is-selected');
      selected = card;

      const scroll = scroller();
      const from = scroll.get();
      const to = targetY();

      if (reduceMotion()) {
        fill(card.dataset);
        scroll.set(to);
        return;
      }

      // Longer trips take a little longer, within limits.
      const dur = gsap.utils.clamp(0.6, 1.2, 0.5 + Math.abs(to - from) / 2500);

      // The flying cover: a copy of the card's cover, fixed to the viewport
      // and outside the smooth-scroll content so the transform there can't
      // move it. Each frame it sits between where the card is and where the
      // review cover is right now, so it lands exactly even while both move.
      const ghost = document.createElement('div');
      ghost.className = 'cover-ghost';
      ghost.append(card.firstElementChild!.cloneNode(true));
      document.body.append(ghost);
      const place = (t: number) => {
        const a = card.getBoundingClientRect();
        const b = cover.getBoundingClientRect();
        const l = gsap.utils.interpolate(a.left, b.left, t);
        const tp = gsap.utils.interpolate(a.top, b.top, t);
        const w = gsap.utils.interpolate(a.width, b.width, t);
        const h = gsap.utils.interpolate(a.height, b.height, t);
        ghost.style.transform = `translate3d(${l}px, ${tp}px, 0)`;
        ghost.style.width = `${w}px`;
        ghost.style.height = `${h}px`;
      };
      place(0);

      const parts = () => [kicker, ...details.children] as HTMLElement[];
      const fly = { t: 0, y: from };
      let startHeight = 0;

      const tl = gsap.timeline({
        onComplete: () => {
          ghost.remove();
          gsap.set(cover, { clearProps: 'visibility' });
          gsap.set(parts(), { clearProps: 'opacity,transform' });
          running = null;
        },
      });
      running = tl;

      // Scroll and flight share one tween and one ease.
      tl.to(fly, {
        t: 1, y: to, duration: dur, ease: 'power3.inOut',
        onUpdate: () => { scroll.set(fly.y); place(fly.t); },
      }, 0);

      // Old review out.
      tl.to(parts(), { opacity: 0, y: -6, duration: 0.22, ease: 'power2.in', stagger: 0.03 }, 0);
      tl.to(cover, { opacity: 0.25, duration: 0.22 }, 0);

      // Swap while it's invisible, then ease the row to its new height.
      tl.call(() => {
        startHeight = section.offsetHeight;
        fill(card.dataset);
        gsap.set(cover, { visibility: 'hidden', opacity: 1 });
        gsap.set(parts(), { opacity: 0, y: 10 });
        const end = section.offsetHeight;
        resizing = gsap.fromTo(section, { height: startHeight, overflow: 'hidden' }, {
          height: end, duration: 0.5, ease: 'power2.inOut',
          onComplete: () => { gsap.set(section, { clearProps: 'height,overflow' }); resizing = null; },
        });
      }, [], 0.28);

      // New review in, as the scroll lands.
      tl.to(parts(), {
        opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', stagger: 0.06,
      }, Math.max(0.32, dur - 0.35));

      // The ghost hands over to the real cover where it landed.
      tl.call(() => { gsap.set(cover, { clearProps: 'visibility' }); ghost.remove(); }, [], dur);
    };

    document.addEventListener('click', (e) => {
      const card = (e.target as Element).closest('.book-card');
      if (card) select(card as HTMLElement);
    });

    // The cards are focusable, so keyboard users get the same thing.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const card = (e.target as Element).closest('.book-card');
      if (!card) return;
      e.preventDefault();
      select(card as HTMLElement);
    });
  }
</script>

<style>
  /* Rows, labels and the page head are shared styles in Layout.astro. */

  /* ---- stats: big numbers, small captions, no boxes ---- */
  .stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2rem 2rem;
    margin: 0; max-width: 42em;
  }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .stats dd {
    margin: 0; font-size: 2.2rem; font-weight: 400; line-height: 1.1;
    letter-spacing: -.02em; font-variant-numeric: tabular-nums;
  }
  .stats dt { color: var(--muted); font-size: .9rem; margin-top: .3rem; }

  /* ---- year rows ---- */
  .count { display: block; color: var(--muted); }
  .label .count { font-size: inherit; }

  .book-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: 1.1rem .9rem;
  }

  .book-card {
    position: relative; aspect-ratio: 2 / 3; cursor: pointer;
    background: var(--line); overflow: hidden;
  }
  .book-card:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .book-card img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter .4s ease;
  }
  .book-card:hover img, .book-card:focus-visible img, .book-card.is-selected img { filter: none; }

  /* The cover whose review is currently open. */
  .book-card.is-selected { outline: 2px solid var(--accent); outline-offset: 3px; }

  .no-cover {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    padding: .5rem; text-align: center; background: var(--line);
  }
  .no-cover-title {
    font-size: .7rem; line-height: 1.2; color: var(--ink);
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }

  /* The cover copy that flies from the grid to the review (see script). */
  :global(.cover-ghost) {
    position: fixed; left: 0; top: 0; z-index: 50; pointer-events: none;
    overflow: hidden; background: var(--line); will-change: transform;
  }
  :global(.cover-ghost img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---- review row ---- */
  .review { scroll-margin-top: 1rem; }
  .review:focus { outline: none; }
  .review-content { display: flex; gap: clamp(1.2rem, 3vw, 2rem); align-items: flex-start; max-width: 42em; }

  .review-cover {
    width: 7.5rem; flex-shrink: 0; aspect-ratio: 2 / 3;
    overflow: hidden; background: var(--line);
  }
  /* :global because clicking a book replaces this cover from JS, and injected
     nodes carry no scope attribute. Same for the .no-cover fallback. */
  .review-cover :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .review-cover :global(.no-cover) {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
    padding: .5rem; text-align: center; background: var(--line);
  }
  .review-cover :global(.no-cover-title) { font-size: .75rem; line-height: 1.2; color: var(--ink); }

  .review-details { flex: 1; min-width: 0; }
  .review-title {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem); font-weight: 400; letter-spacing: -.01em;
    line-height: 1.2; margin: 0;
  }
  .review-author { color: var(--muted); margin: .3rem 0 0; }
  .review-meta {
    display: flex; flex-wrap: wrap; gap: .2rem 1rem;
    color: var(--muted); font-size: .9rem; margin: .5rem 0 1.2rem;
  }
  .review-rating { color: var(--ink); letter-spacing: .05em; }

  .review-text { font-size: 1.02rem; line-height: 1.6; }
  .review-text.is-empty { color: var(--muted); font-style: italic; }

  /* set:html content carries no scope attribute, so its children need :global. */
  .review-text :global(p) { margin: 0 0 .9rem; }
  .review-text :global(p:last-child) { margin-bottom: 0; }
  .review-text :global(a) { text-decoration-color: var(--muted); }
  .review-text :global(a:hover) { text-decoration-color: var(--accent); }
  .review-text :global(blockquote) {
    margin: 1rem 0; padding-left: 1rem;
    border-left: 2px solid var(--line); color: var(--muted);
  }
  .review-text :global(ul),
  .review-text :global(ol) { margin: .9rem 0; padding-left: 1.2rem; }

  /* ---- tooltip: flat paper slip with a hairline ---- */
  .tip {
    position: absolute; z-index: 60; pointer-events: none;
    background: var(--bg); color: var(--ink);
    border: 1px solid var(--line);
    padding: .8rem 1rem; width: max-content; max-width: 18rem;
    opacity: 0; transition: opacity .15s ease;
  }
  .tip p { margin: 0; }
  .tip-title { font-size: 1rem; line-height: 1.25; }
  .tip-sub { color: var(--muted); font-size: .85rem; margin-top: .2rem !important; }
  .tip-rating { color: var(--ink); }
  .tip-hint {
    color: var(--muted); font-size: .8rem;
    border-top: 1px solid var(--line); margin-top: .6rem !important; padding-top: .5rem;
  }

  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .label .count { display: inline; margin-left: .6rem; }
    .book-grid { grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr)); gap: .9rem .7rem; }
  }
  @media (max-width: 480px) {
    .review-content { flex-direction: column; }
    .review-cover { width: 6.5rem; }
  }
</style>
