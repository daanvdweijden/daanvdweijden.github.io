---
// The puzzle-data easter egg. Not linked from the nav — reachable only via the
// small "∙" after the copyright in the footer. Everything reads the build
// artifacts in data/ (activity.json, crux_stats.json, the fetcher CSVs); nothing
// fetches live. See src/lib/puzzles.ts for the shaping.
import Layout from '../../layouts/Layout.astro';
import Heatmap from '../../components/Heatmap.astro';
import TodayCard from '../../components/TodayCard.astro';
import TrendChart from '../../components/TrendChart.astro';
import TimeOfDay from '../../components/TimeOfDay.astro';
import WeekdayBars from '../../components/WeekdayBars.astro';
import PuzzleIcon from '../../components/PuzzleIcon.astro';
import {
  getActivity,
  cruxStats,
  buildCells,
  currentAnyStreak,
  currentStreakDates,
  today,
  totalPuzzlesSolved,
  fastestMini,
  miniMonthlyAvg,
  hourHistogram,
  weekdayMiniAvg,
  cleanSplit,
  solveTimesByDate,
  gameCounts,
  ICON_SLUGS,
  formatSeconds,
  formatDay,
} from '../../lib/puzzles';

const a = getActivity();
const cells = buildCells(a);
const streak = currentAnyStreak(a);
const streakDates = currentStreakDates(a);
const total = totalPuzzlesSolved(a);
const fastMini = fastestMini();
const monthly = miniMonthlyAvg();
const thisMonthAvg = monthly[monthly.length - 1]?.avg ?? 0;
const hist = hourHistogram();
const weekday = weekdayMiniAvg();
const miniSplit = cleanSplit('mini_scores.csv');
const midiSplit = cleanSplit('midi_scores.csv');
const solveTimes = solveTimesByDate();
const todayDay = today(a);
// Only games we ship a real icon for — the rotation panel is icon-only.
const rotation = gameCounts(a).filter((g) => ICON_SLUGS.has(g.slug));

const pct = (s: { clean: number; assisted: number }) =>
  Math.round((s.clean / Math.max(s.clean + s.assisted, 1)) * 100);
---

<Layout title="Puzzles" description="A daily puzzle log — for me, mostly." noindex>
  <main class="wrap page">
    <header class="page-head">
      <p class="eyebrow">PERSONAL</p>
      <h1>Daily Puzzles</h1>
      <p class="lede">
        A running log of the crosswords I solve — some over breakfast, a
        suspicious number just before midnight. Last updated {formatDay(a.generated, true)}.
      </p>
    </header>

    <section class="stats">
      <div class="stat">
        <p class="stat-num">{total}</p>
        <p class="stat-label">Puzzles solved</p>
      </div>
      <div class="stat">
        <p class="stat-num">{streak}</p>
        <p class="stat-label">Day streak · any puzzle</p>
      </div>
      <div class="stat">
        <p class="stat-num">{formatSeconds(fastMini)}</p>
        <p class="stat-label">Fastest Mini</p>
      </div>
      <div class="stat">
        <p class="stat-num">{formatSeconds(thisMonthAvg)}</p>
        <p class="stat-label">Mini avg · this month</p>
      </div>
    </section>

    <section class="today-row">
      <div class="bento-card">
        <TodayCard day={todayDay} activity={a} />
      </div>
      <div class="bento-card">
        <p class="kicker">Activity · hover a day</p>
        <div class="hm-wrap">
          <Heatmap cells={cells} activity={a} streakDates={streakDates} solveTimes={solveTimes} />
        </div>
      </div>
    </section>

    <section class="pair">
      <div class="bento-card">
        <p class="kicker">Mini solve time · monthly avg</p>
        <TrendChart points={monthly} pb={fastMini} />
      </div>
      <div class="bento-card">
        <p class="kicker">When I actually solve</p>
        <TimeOfDay hist={hist} />
      </div>
    </section>

    <section class="pair">
      <div class="bento-card">
        <p class="kicker">Mini avg by weekday</p>
        <WeekdayBars data={weekday} />
      </div>
      <div class="bento-card">
        <p class="kicker">Clean vs. autocheck</p>
        <div class="splits">
          <div class="split-block">
            <p class="split-head">Mini — {pct(miniSplit)}% clean</p>
            <div class="split"><span class="a" style={`width:${pct(miniSplit)}%`}></span></div>
            <div class="split-legend"><span>clean {miniSplit.clean}</span><span>assisted {miniSplit.assisted}</span></div>
          </div>
          <div class="split-block">
            <p class="split-head">Midi — {pct(midiSplit)}% clean</p>
            <div class="split"><span class="a" style={`width:${pct(midiSplit)}%`}></span></div>
            <div class="split-legend"><span>clean {midiSplit.clean}</span><span>assisted {midiSplit.assisted}</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="pair">
      <div class="bento-card crux-card">
        <p class="kicker">Crux · consistency</p>
        <p class="crux-num">{cruxStats.crux_streak_current}</p>
        <p class="crux-sub">day streak · {cruxStats.win_percentage}% solved</p>
        <p class="crux-meta">avg {cruxStats.average_time} · fastest {cruxStats.fastest_time}</p>
      </div>
      <div class="bento-card">
        <p class="kicker">Games in rotation · hover for plays</p>
        <div class="rotation">
          {rotation.map((g) => (
            <div class="rot-chip" tabindex="0">
              <PuzzleIcon slug={g.slug} label={g.label} size={46} />
              <span class="rot-tip">{g.label} · {g.count}×</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    
    <div id="chart-tip" class="chart-tip" role="tooltip"></div>
  </main>
</Layout>

<script>
  const tip = document.getElementById('chart-tip');
  if (tip) {
    const show = (el: Element) => {
      const text = (el as HTMLElement).dataset.tip;
      if (!text) return;
      tip.textContent = text;
      tip.style.opacity = '1';
      const r = el.getBoundingClientRect();
      const tw = tip.offsetWidth;
      let left = r.left + r.width / 2 - tw / 2;
      left = Math.max(8, Math.min(left, window.innerWidth - tw - 8));
      tip.style.left = left + 'px';
      // position slightly above the element
      tip.style.top = window.scrollY + r.top - tip.offsetHeight - 8 + 'px';
    };
    const hide = () => { tip.style.opacity = '0'; };

    document.addEventListener('mouseover', (e) => {
      const target = (e.target as Element).closest('[data-tip]');
      if (target) show(target);
    });
    document.addEventListener('mouseout', (e) => {
      if (!(e.target as Element).closest('[data-tip]')) hide();
    });
    document.addEventListener('focusin', (e) => {
      const target = (e.target as Element).closest('[data-tip]');
      if (target) show(target);
    });
    document.addEventListener('focusout', hide);
  }
</script>

<style>
  /* Only set vertical padding -- the `padding` shorthand would zero out the
     horizontal padding `.wrap` provides, pulling content outside the header. */
  .page { padding-top: clamp(2.5rem, 7vw, 5rem); padding-bottom: clamp(3rem, 8vw, 6rem); }

  .page-head { margin-bottom: clamp(2rem, 5vw, 3rem); }
  .eyebrow {
    font-family: var(--mono); font-size: .72rem; text-transform: uppercase;
    letter-spacing: .14em; color: var(--muted); margin: 0 0 1rem;
  }
  .page-head h1 {
    font-family: var(--serif); font-weight: 500;
    font-size: clamp(2.2rem, 6vw, 3.4rem); letter-spacing: -0.025em; line-height: 1.05; margin: 0;
  }
  .lede { margin: 1rem 0 0; max-width: 54ch; color: var(--muted); }

  .kicker {
    font-family: var(--mono); font-size: .68rem; text-transform: uppercase;
    letter-spacing: .12em; color: var(--muted); margin: 0 0 1rem;
  }

  /* ---- stat row ---- */
  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
    margin: clamp(2rem, 5vw, 3rem) 0 1.5rem;
  }
  .stat {
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
    padding: 1.2rem 1.4rem;
  }
  .stat-num { font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0; letter-spacing: -0.02em; }
  .stat-label { font-family: var(--mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: .4rem 0 0; }

  /* ---- shared card ---- */
  .bento-card {
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    display: flex; flex-direction: column;
  }

  .today-row { display: grid; grid-template-columns: 1fr 1.7fr; gap: 16px; margin-bottom: 1.5rem; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 1.5rem; }

  .hm-wrap { flex: 1; display: flex; align-items: center; min-width: 0; }
  .hm-wrap :global(.heatmap) { width: 100%; }

  /* ---- clean vs assisted ---- */
  .splits { display: flex; flex-direction: column; gap: 1.4rem; margin-top: .2rem; }
  .split-head { font-size: .9rem; margin: 0 0 .5rem; }
  .split { height: 12px; border-radius: 6px; background: var(--line); overflow: hidden; }
  .split .a { display: block; height: 100%; background: var(--p-green-fg); }
  .split-legend {
    display: flex; justify-content: space-between; margin-top: .4rem;
    font-family: var(--mono); font-size: .68rem; color: var(--muted);
  }

  /* ---- crux ---- */
  .crux-num { font-family: var(--serif); font-size: clamp(2.4rem, 6vw, 3.2rem); margin: .2rem 0 0; letter-spacing: -.02em; line-height: 1; }
  .crux-sub { font-family: var(--mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: .6rem 0 0; }
  .crux-meta { font-size: .86rem; color: var(--muted); margin: 1rem 0 0; }

  /* ---- rotation (4x2 grid of icons) ---- */
  .rotation {
    display: grid; grid-template-columns: repeat(4, max-content);
    gap: 12px; margin-top: auto; padding-top: 1.4rem;
  }
  .rot-chip {
    position: relative; line-height: 0; cursor: default;
    transition: transform .16s ease;
  }
  .rot-chip:hover, .rot-chip:focus-visible { transform: translateY(-4px); z-index: 20; outline: none; }
  .rot-tip {
    position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    white-space: nowrap; font-family: var(--mono); font-size: .64rem;
    text-transform: uppercase; letter-spacing: .04em;
    color: var(--ink); background: var(--surface);
    border: 1px solid var(--line); border-radius: 6px; padding: .25rem .5rem;
    opacity: 0; pointer-events: none; transition: opacity .12s ease; line-height: 1;
  }
  .rot-chip:hover .rot-tip, .rot-chip:focus-visible .rot-tip { opacity: 1; }

  @media (max-width: 760px) {
    .today-row, .pair { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
  }

  .chart-tip {
    position: absolute; z-index: 60; pointer-events: none;
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line); border-radius: 6px;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--ink) 12%, transparent);
    padding: .35rem .6rem; font-size: .75rem; white-space: nowrap;
    opacity: 0; transition: opacity .12s ease;
  }
</style>
