---
// The puzzle-data easter egg. Not linked from the nav — reachable only via the
// small "∙" after the copyright in the footer. Everything reads the build
// artifacts in data/ (activity.json, crux_stats.json, the fetcher CSVs); nothing
// fetches live. See src/lib/puzzles.ts for the shaping.
import Layout from '../../layouts/Layout.astro';
import Heatmap from '../../components/Heatmap.astro';
import TodayCard from '../../components/TodayCard.astro';
import TrendChart from '../../components/TrendChart.astro';
import TimeOfDay from '../../components/TimeOfDay.astro';
import WeekdayBars from '../../components/WeekdayBars.astro';
import {
  getActivity,
  buildCells,
  currentAnyStreak,
  currentStreakDates,
  today,
  totalPuzzlesSolved,
  fastestMini,
  todayMiniSeconds,
  miniMonthlyAvg,
  hourHistogram,
  weekdayMiniAvg,
  hintBreakdown,
  hintTotal,
  type HintSlice,
  solveTimesByDate,
  formatSeconds,
  formatDay,
} from '../../lib/puzzles';

const a = getActivity();
const cells = buildCells(a);
const streak = currentAnyStreak(a);
const streakDates = currentStreakDates(a);
const total = totalPuzzlesSolved(a);
const fastMini = fastestMini();
const todayMini = todayMiniSeconds(a);
const monthly = miniMonthlyAvg();
const thisMonthAvg = monthly[monthly.length - 1]?.avg ?? 0;
const hist = hourHistogram();
const weekday = weekdayMiniAvg();
const miniSplit = hintBreakdown('mini_scores.csv');
const midiSplit = hintBreakdown('midi_scores.csv');
const solveTimes = solveTimesByDate();
const todayDay = today(a);

// % of solves in a given bucket, rounded — used for the "% clean" headline.
const share = (slices: HintSlice[], key: string) => {
  const total = hintTotal(slices);
  const hit = slices.find((s) => s.key === key)?.count ?? 0;
  return total ? Math.round((hit / total) * 100) : 0;
};
---

<Layout title="Puzzles" description="A daily puzzle log — for me, mostly." noindex>
  <main class="wrap">
    <section class="row page-head" data-reveal>
      <div></div>
      <div>
        <h1 class="page-title">Daily puzzles</h1>
        <p class="page-intro">
          A running log of the daily puzzles I solve. NYT Mini is the standard, but trying to do some additional NYT and NRC puzzles as well. Last updated {formatDay(a.generated, true)}.
        </p>
      </div>
    </section>

    <section class="row" data-reveal>
      <h2 class="label">At a glance</h2>
      <dl class="stats">
        <div>
          <dt>Puzzles solved</dt>
          <dd>{total}</dd>
        </div>
        <div>
          <dt>Day streak, any puzzle</dt>
          <dd>{streak}</dd>
        </div>
        <div>
          <dt>Mini time today</dt>
          <dd>{todayMini !== null ? formatSeconds(todayMini) : '—'}</dd>
        </div>
        <div>
          <dt>Mini average this month</dt>
          <dd>{formatSeconds(thisMonthAvg)}</dd>
        </div>
      </dl>
    </section>

    <section class="row" data-reveal>
      <h2 class="label">Today</h2>
      <TodayCard day={todayDay} activity={a} />
    </section>

    <section class="row" data-reveal>
      <h2 class="label">Activity</h2>
      <div>
        <Heatmap cells={cells} activity={a} streakDates={streakDates} solveTimes={solveTimes} />
        <p class="note">Outlined days are the current streak.</p>
      </div>
    </section>

    <section class="row" data-reveal>
      <h2 class="label">Mini solve time, monthly average</h2>
      <div class="chart"><TrendChart points={monthly} pb={fastMini} /></div>
    </section>

    <section class="row" data-reveal>
      <h2 class="label">When I solve the Mini</h2>
      <div class="chart"><TimeOfDay hist={hist} /></div>
    </section>

    <section class="row" data-reveal>
      <h2 class="label">Mini average by weekday</h2>
      <div class="chart"><WeekdayBars data={weekday} /></div>
    </section>

    <section class="row" data-reveal>
      <h2 class="label">Clean or assisted</h2>
      <div class="splits">
        {[
          { name: 'Mini', slices: miniSplit },
          { name: 'Midi', slices: midiSplit },
        ].map(({ name, slices }) => {
          const total = hintTotal(slices);
          return (
            <div>
              <p class="split-head">{name}, {share(slices, 'clean')}% clean</p>
              <div class="split">
                {slices.map((s) => (
                  <span
                    class={`seg ${s.key}`}
                    style={`width:${(s.count / total) * 100}%`}
                    data-tip={`${s.label}: ${s.count} (${Math.round((s.count / total) * 100)}%)`}
                  ></span>
                ))}
              </div>
              <p class="split-legend">
                {slices.map((s) => (
                  <span class="lg"><i class={`sw ${s.key}`}></i>{s.label} {s.count}</span>
                ))}
              </p>
            </div>
          );
        })}
      </div>
    </section>

    <div id="chart-tip" class="chart-tip" role="tooltip"></div>
  </main>
</Layout>
<script>
  const tip = document.getElementById('chart-tip');
  if (tip) {
    const show = (el: Element) => {
      const text = (el as HTMLElement).dataset.tip;
      if (!text) return;
      tip.textContent = text;
      tip.style.opacity = '1';
      const r = el.getBoundingClientRect();
      const tw = tip.offsetWidth;
      let left = r.left + r.width / 2 - tw / 2;
      left = Math.max(8, Math.min(left, window.innerWidth - tw - 8));
      tip.style.left = left + 'px';
      // position slightly above the element
      tip.style.top = window.scrollY + r.top - tip.offsetHeight - 8 + 'px';
    };
    const hide = () => { tip.style.opacity = '0'; };

    document.addEventListener('mouseover', (e) => {
      const target = (e.target as Element).closest('[data-tip]');
      if (target) show(target);
    });
    document.addEventListener('mouseout', (e) => {
      if (!(e.target as Element).closest('[data-tip]')) hide();
    });
    document.addEventListener('focusin', (e) => {
      const target = (e.target as Element).closest('[data-tip]');
      if (target) show(target);
    });
    document.addEventListener('focusout', hide);
  }
</script>

<style>
  /* Rows, labels and the page head are shared styles in Layout.astro. */
  h2.label { font-size: .9rem; }

  /* ---- at a glance: big numbers, small captions, no boxes ---- */
  .stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem 2rem;
    margin: 0;
  }
  .stats > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .stats dd {
    margin: 0; font-size: 2.2rem; font-weight: 400; line-height: 1.05;
    letter-spacing: -.02em; font-variant-numeric: tabular-nums;
  }
  .stats dt { font-size: .85rem; color: var(--muted); margin-top: .4rem; line-height: 1.3; }

  .note { font-size: .85rem; color: var(--muted); margin: .9rem 0 0; }
  .chart { max-width: 34rem; }

  /* ---- clean vs assisted ---- */
  .splits { display: flex; flex-direction: column; gap: 1.6rem; max-width: 34rem; }
  .split-head { margin: 0 0 .5rem; }
  .split { display: flex; height: 10px; background: var(--line); }
  .split .seg { height: 100%; }
  /* Least to most assisted: ink → muted → line, with the accent for reveals. */
  .seg, .sw { background: var(--muted); } /* fallback for an unexpected hint_type */
  .seg.clean, .sw.clean { background: var(--ink); }
  .seg.checked, .sw.checked { background: color-mix(in srgb, var(--ink) 55%, var(--bg)); }
  .seg.autocheck, .sw.autocheck { background: color-mix(in srgb, var(--ink) 25%, var(--bg)); }
  .seg.revealed, .sw.revealed { background: var(--accent); }
  .split-legend {
    display: flex; flex-wrap: wrap; gap: .2rem 1.2rem; margin: .55rem 0 0;
    font-size: .85rem; color: var(--muted);
  }
  .split-legend .lg { display: inline-flex; align-items: center; gap: .4rem; }
  .sw { width: .6em; height: .6em; flex: none; }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .chart-tip {
    position: absolute; z-index: 60; pointer-events: none;
    background: var(--bg); color: var(--ink);
    border: 1px solid var(--line);
    padding: .3rem .55rem; font-size: .8rem; white-space: nowrap;
    opacity: 0; transition: opacity .12s ease;
  }
</style>
