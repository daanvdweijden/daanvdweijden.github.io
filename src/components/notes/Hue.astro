---
// <Hue>orange</Hue> / <Hue>blue</Hue>: a colour word in the colour it
// names, so "orange marks…" in the text matches the chart. The word is
// shown as the colour's name in the current theme (the palette swaps in
// dark mode, see lib/hue.ts). Figure subtitles and captions do this by
// themselves. Older names (terracotta, sage, teal, rust) still work.
// Any other text (or text with `c`) is shown as is, in that colour.
import { HUE_WORDS, hueClass, hueHtml } from '../../lib/hue';

interface Props {
  /** Which colour, for text that isn't itself a colour word. */
  c?: 'orange' | 'blue' | 'terracotta' | 'sage' | 'teal' | 'rust';
}
const text = (await Astro.slots.render('default')).trim();
const html = !Astro.props.c && HUE_WORDS[text.toLowerCase()]
  ? hueHtml(text)
  : `<span class="hue ${hueClass(Astro.props.c ?? text)}">${text}</span>`;
---

<Fragment set:html={html} />
