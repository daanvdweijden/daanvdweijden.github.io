---
// Scrollytelling: a sticky graphic with text steps scrolling past it.
//
// <Scrolly>
//   <Chart slot="graphic" name="myChart" data={rows} />
//   <Step>First, look at…</Step>
//   <Step>Now the terracotta line…</Step>
// </Scrolly>
//
// The active step (0, 1, 2…) is passed to every chart inside as `ctx.step`, so
// one chart function can show a different state per step. Use this for the one
// showpiece of a note, not for every chart.
---

<div class="scrolly wide" data-step="0">
  <div class="scrolly-graphic"><slot name="graphic" /></div>
  <div class="scrolly-steps"><slot /></div>
</div>

<script>
  // A step is active once its top passes the trigger line. On wide screens
  // that line is the middle of the screen; on phones the chart sits on top,
  // so the line is in the free space below it, high enough that the whole
  // card is readable when its step comes on. Checked on every
  // scroll, so a fast scroll can never skip a step or leave the wrong one on.
  const phone = matchMedia('(max-width: 760px)');
  const roots = [...document.querySelectorAll<HTMLElement>('.scrolly')];
  const update = () => {
    for (const root of roots) {
      const steps = [...root.querySelectorAll<HTMLElement>('.scrolly-step')];
      const graphic = root.querySelector<HTMLElement>('.scrolly-graphic')!;
      const top = phone.matches ? Math.max(0, graphic.getBoundingClientRect().bottom) : 0;
      let i = 0;
      steps.forEach((s, j) => {
        const r = s.getBoundingClientRect();
        // Phones: switch once the whole card is in view (or halfway up the free space).
        const line = phone.matches
          ? Math.max(top + 8, Math.min(top + (innerHeight - top) * 0.6, innerHeight - r.height - 16))
          : innerHeight / 2;
        if (r.top < line) i = j;
      });
      steps.forEach((s, j) => s.classList.toggle('is-active', j === i));
      if (root.dataset.step === String(i)) continue;
      root.dataset.step = String(i);
      root.dispatchEvent(new CustomEvent('stepchange', { detail: i }));
    }
  };
  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; update(); });
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  update();
</script>

<style>
  /* Wide screens: steps in the narrow left column, graphic sticky on the
     right — the same 5/7 split as the page. */
  .scrolly {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(2rem, 6vw, 6rem);
    margin: clamp(2rem, 5vw, 3.5rem) 0;
  }
  .scrolly-graphic {
    grid-column: 2; grid-row: 1;
    position: sticky; top: 12vh; align-self: start;
    min-height: 60vh; display: flex; align-items: center;
  }
  .scrolly-graphic > :global(*) { width: 100%; }
  .scrolly-steps { grid-column: 1; grid-row: 1; padding: 30vh 0 40vh; }
  .scrolly-steps :global(.scrolly-step:last-child) { margin-bottom: 0; }

  /* Phones: the graphic sticks to the top and the text cards scroll up from
     below and slide under it, so text never covers the chart. */
  @media (max-width: 760px) {
    .scrolly { display: block; }
    .scrolly-graphic {
      top: 0; min-height: 0; padding: .75rem 0;
      background: var(--bg); z-index: 2;
      box-shadow: 0 10px 12px -10px color-mix(in srgb, var(--ink) 18%, transparent);
    }
    .scrolly-steps { position: relative; z-index: 1; padding: 35vh 0 45vh; }
  }
</style>
