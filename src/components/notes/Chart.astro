---
// <Chart name="fnName" data={rows} />: renders the function `fnName` exported
// from the current note's charts.ts (src/content/notes/<slug>/charts.ts).
// Data is inlined as JSON, so keep it small (pre-aggregate in the workshop).
interface Props {
  /** Name of the exported function in the note's charts.ts. */
  name: string;
  data?: unknown;
  /** Reserved height in px while the chart loads (avoids layout jumps). */
  height?: number;
  /** Text alternative: what the chart shows, in one sentence. */
  alt?: string;
  /** Another note's folder to take the chart from. Defaults to this note. */
  from?: string;
}
const { name, data, height = 320, alt, from = Astro.params.id } = Astro.props;
const json = data === undefined ? undefined : JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="chart" data-chart={name} data-from={from} style={`min-height:${height}px`}>
  {json && <script type="application/json" set:html={json} />}
  <div class="chart-canvas" aria-label={alt} role={alt ? 'img' : undefined}></div>
  <noscript><p class="chart-fallback">This chart needs JavaScript.</p></noscript>
</div>

<script>
  import { readTheme, type ChartFn } from '../../lib/chart';
  import { scrubber, type Scrub } from '../../lib/morph';

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // Every note's charts.ts, loaded only when a chart on the page needs it.
  const modules = import.meta.glob<Record<string, ChartFn>>('../../content/notes/*/charts.ts');

  const charts = [...document.querySelectorAll<HTMLElement>('.chart[data-chart]')];

  // Charts draw only when they come within NEAR of the screen, so opening a
  // long note doesn't run every chart at once. Off-screen charts that need a
  // redraw (theme switch, resize) are marked stale and redrawn on return.
  const NEAR = '600px';
  const onNear = new Map<Element, (near: boolean) => void>();
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) onNear.get(e.target)?.(e.isIntersecting);
  }, { rootMargin: `${NEAR} 0px` });

  // Fetch the chart code (Plot + charts.ts) while the browser is idle, so
  // the first chart doesn't wait on the network when it scrolls into view.
  const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 2000 }) : setTimeout(cb, 200));
  idle(() => {
    for (const from of new Set(charts.map((el) => el.dataset.from))) modules[`../../content/notes/${from}/charts.ts`]?.();
  });

  for (const el of charts) {
    const canvas = el.querySelector<HTMLElement>('.chart-canvas')!;
    const dataEl = el.querySelector('script[type="application/json"]');
    const data = dataEl ? JSON.parse(dataEl.textContent || 'null') : undefined;
    const scrolly = el.closest<HTMLElement>('.scrolly');
    const key = `../../content/notes/${el.dataset.from}/charts.ts`;
    let fn: ChartFn | undefined;
    let lastWidth = 0;
    let pending = 0;
    let near = false;
    // Needs a (re)draw: never drawn yet, or something changed while away.
    let stale = true;
    // Inside a <Scrolly>: the transition between step k and k+1 that is
    // currently set up, and seeked to the scroll position on every frame.
    let seg: { k: number; scrub: Scrub } | null = null;
    let building = false;
    // Bumped on every redraw, so a transition rendered before it is thrown away.
    let gen = 0;
    let render: (step: number) => Promise<Element> = async () => { throw new Error('not loaded'); };

    const fail = (msg: string) => {
      canvas.innerHTML = `<p class="chart-fallback">${msg}</p>`;
      console.error(`[chart] ${msg}`);
    };

    /** Scrolly position (0 = step 0, 1.5 = halfway to step 2), clamped to the steps. */
    const position = () => {
      const n = Number(scrolly?.dataset.steps ?? 1);
      let p = Number(scrolly?.dataset.pos ?? 0);
      // Reduced motion: jump between states instead of morphing.
      if (reduceMotion.matches) p = Math.round(p);
      return { n, p: Math.min(Math.max(p, 0), Math.max(0, n - 1)) };
    };

    /** Show the scrolly chart at the current scroll position. */
    const sync = async (): Promise<void> => {
      if (!near || stale || building) return;
      const { n, p } = position();
      if (n < 2) {
        canvas.replaceChildren(await render(0));
        return;
      }
      const k = Math.min(Math.floor(p), n - 2);
      if (seg?.k !== k) {
        // Entering another pair of steps. Each step is rendered once and
        // reused (a transition leaves its renders as it found them).
        seg?.scrub.reset();
        seg = null;
        building = true;
        const g = gen;
        try {
          const a = await render(k);
          const b = await render(k + 1);
          if (g === gen) {
            seg = { k, scrub: scrubber(a, b) };
            // Render the neighbouring steps while the reader is reading, so
            // the next transition doesn't have to wait for them.
            for (const s of [k + 2, k - 1]) if (s >= 0 && s < n) idle(() => { if (g === gen) render(s); });
          }
        } finally {
          building = false;
        }
        return sync(); // the position may have moved on while rendering
      }
      seg.scrub.show(canvas, p - k);
    };

    const draw = async () => {
      // Off screen: redraw in the latest state on return.
      if (!near) { stale = true; return; }
      stale = false;
      seg?.scrub.reset();
      seg = null;
      gen++;
      lastWidth = canvas.clientWidth;
      if (!fn) {
        const load = modules[key];
        if (!load) return fail(`No charts.ts found for "${el.dataset.from}".`);
        const mod = await load();
        fn = mod[el.dataset.chart!];
        if (typeof fn !== 'function') return fail(`charts.ts has no export "${el.dataset.chart}".`);
      }
      const chart = fn;
      const ctx = { ...readTheme(el), width: lastWidth, el };
      const cache = new Map<number, Promise<Element>>();
      render = (step) => {
        if (!cache.has(step)) cache.set(step, Promise.resolve().then(() => chart(data, { ...ctx, step })));
        return cache.get(step)!;
      };
      try {
        if (scrolly) await sync();
        else canvas.replaceChildren(await render(0));
        el.style.minHeight = '';
      } catch (err) {
        fail(`"${el.dataset.chart}" threw: ${(err as Error).message}`);
      }
    };
    // Coalesce bursts (resize drags, several events at once) into one draw.
    const redraw = () => {
      clearTimeout(pending);
      pending = window.setTimeout(draw, 30);
    };

    onNear.set(el, (isNear) => {
      near = isNear;
      if (near && stale) draw();
      else if (near) sync().catch((err) => fail(`"${el.dataset.chart}" threw: ${err.message}`));
    });
    io.observe(el);
    // Redraw when the width changes (not on every height change we cause).
    new ResizeObserver(() => { if (canvas.clientWidth !== lastWidth) redraw(); }).observe(canvas);
    // Redraw when the colour scheme changes (footer switch or system).
    new MutationObserver(redraw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redraw);
    // Follow the scroll position of a surrounding <Scrolly>, every frame.
    scrolly?.addEventListener('scrollprogress', () => {
      sync().catch((err) => fail(`"${el.dataset.chart}" threw: ${err.message}`));
    });
  }
</script>

<style>
  .chart { position: relative; width: 100%; --plot-background: var(--bg); }
  .chart-canvas { width: 100%; position: relative; }
  .chart :global(svg) { display: block; max-width: 100%; height: auto; }
  .chart :global(.chart-fallback) { color: var(--muted); font-size: .9rem; margin: 0; }
</style>
