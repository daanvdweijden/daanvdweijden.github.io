---
// <Pic id="future">future</Pic>: a name in the text with a small inline
// picture before it. The picture is src/content/notes/<this note>/img/<id>.jpg
// (or .png/.webp). Round for artists; pass `album` for a square cover.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  /** File name (without extension) in this note's img/ folder. */
  id: string;
  /** Square corners, for album covers. */
  album?: boolean;
}
const { id, album = false } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../../content/notes/*/img/*.{jpg,jpeg,png,webp}', { eager: true });
const key = Object.keys(all).find((k) => k.includes(`/notes/${Astro.params.id}/img/${id}.`));
const img = key ? all[key].default : undefined;
if (!img) console.warn(`[Pic] no image "${id}" for note "${Astro.params.id}"`);
// Shown at ~1.3em, so a 64px square WebP is sharp on 3x screens and only a
// couple of KB (the originals are up to 80 KB each).
const small = img && (await getImage({ src: img, width: 64, height: 64, fit: 'cover', format: 'webp', quality: 80 }));
---

<span class:list={['pic', { album }]}>{small && <img src={small.src} alt="" width="64" height="64" loading="lazy" decoding="async" />}<slot /></span>

<style>
  .pic { white-space: nowrap; }
  .pic img {
    display: inline-block; width: 1.3em; height: 1.3em; object-fit: cover;
    border-radius: 50%; vertical-align: -0.3em; margin: 0 .3em 0 0;
    box-shadow: 0 0 0 1px var(--line);
  }
  .pic.album img { border-radius: 3px; }
</style>
