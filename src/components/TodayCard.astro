---
// The most-recent day's puzzles as a horizontally-stacked row of brand icons.
// Hovering (or focusing) an icon lifts it and reveals the game's name. Icons
// overlap slightly, newest logic-order left-to-right.
import PuzzleIcon from './PuzzleIcon.astro';
import { formatDay, type Activity, type ActivityDay } from '../lib/puzzles';

interface Props {
  day: ActivityDay;
  activity: Activity;
}
const { day, activity } = Astro.props;
const games = day.played.map((slug) => ({ slug, label: activity.game_meta[slug]?.label ?? slug }));
---

<div class="today">
  {games.length > 0 ? (
    <div class="stack">
      {games.map((g) => (
        <button class="chip" type="button" aria-label={g.label}>
          <PuzzleIcon slug={g.slug} label={g.label} size={52} />
          <span class="name">{g.label}</span>
        </button>
      ))}
    </div>
  ) : (
    <p class="empty">Nothing solved yet.</p>
  )}

  <p class="foot">
    {formatDay(day.date)}, {games.length} {games.length === 1 ? 'puzzle' : 'puzzles'}
    {games.length > 0 && <span> · hover one for its name</span>}
  </p>
</div>

<style>
  /* Sits in the right column of a .row; the "Today" label is the row's. */
  .stack { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip {
    appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
    position: relative; line-height: 0;
    transition: transform .16s ease;
  }
  .chip:hover, .chip:focus-visible { transform: translateY(-4px); z-index: 20; outline: none; }
  .chip:focus-visible :global(.picon) { outline: 2px solid var(--ink); outline-offset: 2px; }

  .name {
    position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    white-space: nowrap; font-size: .8rem; line-height: 1;
    color: var(--ink); background: var(--bg);
    border: 1px solid var(--line); padding: .3rem .5rem;
    opacity: 0; pointer-events: none; transition: opacity .12s ease;
  }
  .chip:hover .name, .chip:focus-visible .name { opacity: 1; }

  .foot { font-size: .85rem; color: var(--muted); margin: 1.6rem 0 0; }
  .empty { color: var(--muted); margin: 0; }
</style>
