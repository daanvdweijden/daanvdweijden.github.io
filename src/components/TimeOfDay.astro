---
// A 24-hour histogram of when solves are completed (local Amsterdam time).
// The busiest hours (the top PEAK hours by solve count, computed from the
// data) are drawn in ink and the rest muted, so the peaks read at a glance.
// Inline SVG, scales to its container.
interface Props {
  hist: number[]; // length 24, index = local hour
}
const { hist } = Astro.props;
const W = 320, H = 132;
const padTop = 12, padBot = 22;
const bw = W / 24;
const max = Math.max(...hist, 1);
const barH = (v: number) => (v / max) * (H - padTop - padBot);

// Highlight the PEAK busiest hours. Ties at the cut-off are included, and
// empty hours never count.
const PEAK = 5;
const cutoff = [...hist].sort((a, b) => b - a)[PEAK - 1] ?? 0;
const isPeak = (v: number) => v > 0 && v >= cutoff;
const TICKS: [number, string][] = [[0, '12a'], [6, '6a'], [12, '12p'], [18, '6p'], [23, '11p']];
const hourLabel = (h: number) => (h === 0 ? '12am' : h < 12 ? `${h}am` : h === 12 ? '12pm' : `${h - 12}pm`);
---

<svg viewBox={`0 0 ${W} ${H}`} class="tod" role="img" aria-label="Solves by hour of day, busiest hours highlighted">
  {hist.map((v, h) => (
    <rect
      x={h * bw + 1} y={H - padBot - barH(v)}
      width={bw - 2} height={barH(v)}
      class:list={['bar', { peak: isPeak(v) }]}
      data-tip={`${v} solves at ${hourLabel(h)}`}
      tabindex="0"
    />
  ))}
  {TICKS.map(([h, label]) => (
    <text x={h * bw + bw / 2} y={H - 6} class="axis" text-anchor="middle">{label}</text>
  ))}
</svg>

<style>
  .tod { display: block; width: 100%; height: auto; }
  .bar { transition: fill .12s ease; cursor: default; outline: none; }
  rect.bar { fill: color-mix(in srgb, var(--ink) 25%, var(--bg)); }
  rect.bar.peak { fill: var(--ink); }
  rect.bar:hover, rect.bar:focus-visible { fill: var(--accent); }
  .axis { font-family: var(--font); font-size: 7.5px; fill: var(--muted); }
</style>
