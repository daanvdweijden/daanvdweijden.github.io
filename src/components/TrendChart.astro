---
// Monthly average Mini solve time as a line, oldest→newest, with the personal
// best drawn as a dashed baseline. Pure inline SVG, scales to its container.
import { formatSeconds, type MonthPoint } from '../lib/puzzles';

interface Props {
  points: MonthPoint[];
  pb: number; // fastest solve, seconds — drawn as a reference line
}
const { points, pb } = Astro.props;

const W = 320, H = 132;
const padX = 10, padTop = 16, padBot = 24;
const vals = points.map((p) => p.avg);
const lo = Math.min(pb, ...vals);
const hi = Math.max(...vals);
const span = hi - lo || 1;
const x = (i: number) => padX + (i * (W - 2 * padX)) / Math.max(points.length - 1, 1);
const y = (v: number) => padTop + (1 - (v - lo) / span) * (H - padTop - padBot);

const line = points.map((p, i) => `${x(i).toFixed(1)},${y(p.avg).toFixed(1)}`).join(' ');
const MONTH_INITIAL = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
const first = points[0]?.avg ?? 0;
const last = points[points.length - 1]?.avg ?? 0;
---

<svg viewBox={`0 0 ${W} ${H}`} class="trend" role="img"
     aria-label={`Monthly average Mini solve time, from ${formatSeconds(first)} to ${formatSeconds(last)}`}>
  <!-- personal-best baseline -->
  <line x1={padX} x2={W - padX} y1={y(pb)} y2={y(pb)} class="pb" />
  <text x={W - padX} y={y(pb) - 4} class="pb-label" text-anchor="end">PB {formatSeconds(pb)}</text>

  <polyline points={line} class="curve" />
  {points.map((p, i) => <circle cx={x(i)} cy={y(p.avg)} r="2.4" class="dot" />)}

  <!-- endpoint value labels -->
  <text x={x(0)} y={y(first) - 7} class="val" text-anchor="start">{formatSeconds(first)}</text>
  <text x={x(points.length - 1)} y={y(last) - 7} class="val" text-anchor="end">{formatSeconds(last)}</text>

  {points.map((p, i) => (
    <text x={x(i)} y={H - 8} class="axis" text-anchor="middle">{MONTH_INITIAL[Number(p.month.slice(5, 7)) - 1]}</text>
  ))}
</svg>

<style>
  .trend { display: block; width: 100%; height: auto; overflow: visible; }
  .curve { fill: none; stroke: var(--p-blue-fg); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .dot { fill: var(--p-blue-fg); }
  .pb { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 3; opacity: .7; }
  .pb-label, .axis { font-family: var(--mono); font-size: 8px; fill: var(--muted); }
  .val { font-family: var(--mono); font-size: 8.5px; fill: var(--ink); }
</style>
