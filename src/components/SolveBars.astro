---
// A day-by-day sparkline of solve times, sharing its x-axis with the activity
// heatmap (see src/lib/puzzles.ts: alignSolves). One bar per day in `series`;
// days with no solve render as an empty slot rather than a zero-height bar,
// so gaps in the streak are visible instead of misleading.
import { formatDay, formatSeconds, type DaySlot } from '../lib/puzzles';

interface Props {
  series: DaySlot[];
  color: string; // CSS color value, e.g. 'var(--p-blue-fg)'
}
const { series, color } = Astro.props;
const solved = series.filter((s) => s.seconds !== null) as { date: string; seconds: number }[];
const max = Math.max(...solved.map((s) => s.seconds), 1);
---

<div class="solve-bars" style={`--bar-color: ${color}`}>
  {series.map((slot) =>
    slot.seconds !== null ? (
      <span
        class="bar"
        style={`height: ${Math.max((slot.seconds / max) * 100, 6)}%`}
        title={`${formatDay(slot.date)}: ${formatSeconds(slot.seconds)}`}
      />
    ) : (
      <span class="bar bar--empty" title={`${formatDay(slot.date)}: no solve`} />
    )
  )}
</div>

<style>
  .solve-bars { display: flex; align-items: flex-end; gap: 2px; height: 100px; }
  .bar { flex: 1; min-width: 1px; background: var(--bar-color); border-radius: 1px 1px 0 0; opacity: .75; transition: opacity .2s; }
  .bar:hover { opacity: 1; }
  .bar--empty { height: 3px; background: var(--line); opacity: 1; }
</style>
