---
// GitHub-contributions-style calendar. Renders one continuous run of `cells`
// (see src/lib/puzzles.ts) as week columns, Sunday-first, with month labels
// on top and a sparse weekday rail on the left. Colors run on a single hue
// so it reads as "how much", not "which game" — that's what the legend and
// per-cell tooltip are for.
import { buildCalendar, bucket, tooltip, type Cell, type Activity } from '../lib/puzzles';

interface Props {
  cells: Cell[];
  activity: Activity;
}
const { cells, activity } = Astro.props;
const { weeks, monthLabels } = buildCalendar(cells);
const WEEKDAY_LABELS = ['', 'Mon', '', 'Wed', '', 'Fri', ''];
---

<div class="heatmap">
  <div class="months" aria-hidden="true">
    {monthLabels.map((m) => <span class="month">{m}</span>)}
  </div>
  <div class="body">
    <div class="weekdays" aria-hidden="true">
      {WEEKDAY_LABELS.map((w) => <span class="wd">{w}</span>)}
    </div>
    <div class="cal">
      {weeks.map((week) => (
        <div class="week">
          {week.map((cell) =>
            cell ? (
              <span class="cell" data-bucket={bucket(cell.count)} title={tooltip(cell, activity)} />
            ) : (
              <span class="cell cell--pad" aria-hidden="true" />
            )
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .heatmap { overflow-x: auto; width: 100%; padding-bottom: .25rem; }
  .months { display: flex; gap: 4px; padding-left: 30px; margin-bottom: 6px; height: 14px; }
  .month {
    width: 15px; flex: 0 0 15px; font-family: var(--mono); font-size: .66rem;
    color: var(--muted); white-space: nowrap; overflow: visible;
  }
  .body { display: flex; gap: 8px; }
  .weekdays { display: flex; flex-direction: column; gap: 4px; width: 24px; flex: 0 0 24px; }
  .wd { height: 15px; line-height: 15px; font-family: var(--mono); font-size: .66rem; color: var(--muted); }
  .cal { display: flex; gap: 4px; }
  .week { display: flex; flex-direction: column; gap: 4px; }
  .cell { width: 15px; height: 15px; border-radius: 3px; background: var(--line); }
  .cell--pad { background: transparent; }
  .cell[data-bucket="1"] { background: var(--heat-1); }
  .cell[data-bucket="2"] { background: var(--heat-2); }
  .cell[data-bucket="3"] { background: var(--heat-3); }
  .cell[data-bucket="4"] { background: var(--p-blue-fg); }
</style>
