---
// Renders a game's brand icon as inline SVG (present on first paint, no network
// request). NYT marks (mini/midi/wordle/connections) come from NYT's own icon
// set; NRC marks (crux/cijferblok/vorto/precies-vier) are the NRC dark-mode
// puzzle icons. Games we don't have a mark for fall back to a coloured
// monogram tile. Internal SVG ids are namespaced per icon (build step) so
// several inline icons on one page don't collide.
import { GAME_COLORS } from '../lib/puzzles';

// Eagerly import every icon as a raw string, keyed by slug.
const rawIcons = import.meta.glob<string>('../assets/puzzle-icons/*.svg', {
  query: '?raw', import: 'default', eager: true,
});
const ICONS: Record<string, string> = {};
for (const [path, svg] of Object.entries(rawIcons)) {
  ICONS[path.split('/').pop()!.replace('.svg', '')] = svg as string;
}

interface Props {
  slug: string;
  label: string;
  size?: number;
}
const { slug, label, size = 40 } = Astro.props;
const svg = ICONS[slug];
const fallbackColor = GAME_COLORS[slug] ?? 'var(--muted)';
const initial = label.replace(/^NYT\s+/, '').charAt(0).toUpperCase();
---

<span class="picon" style={`--sz:${size}px`} title={label} role="img" aria-label={label}>
  {svg ? (
    <Fragment set:html={svg} />
  ) : (
    <span class="picon-fallback" style={`background:${fallbackColor}`}>{initial}</span>
  )}
</span>

<style>
  /* The icon artwork is already a rounded tile, so the wrapper must NOT clip or
     re-round it — an overflow:hidden mask with a different radius shaves the
     corners. Just size the box and let the SVG show its own shape. */
  .picon {
    display: inline-block;
    width: var(--sz);
    height: var(--sz);
    flex: 0 0 auto;
    line-height: 0;
  }
  .picon :global(svg) { display: block; width: 100%; height: 100%; }
  /* Only the flat monogram fallback needs its own rounding + hairline ring. */
  .picon-fallback {
    display: grid;
    place-items: center;
    width: 100%; height: 100%;
    border-radius: calc(var(--sz) * 0.22);
    color: #fff;
    font-family: var(--mono);
    font-weight: 500;
    font-size: calc(var(--sz) * 0.4);
    line-height: 1;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 12%, transparent);
  }
</style>
