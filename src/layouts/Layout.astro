---
// Shared shell for every page: <head> + design tokens + header + footer.
// Deliberately plain: paper background, one grotesk (Archivo), small corner
// header. The one loud element lives on
// the homepage (the colour block behind the portrait).
import { site } from '../site.config';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/archivo/wght-italic.css';

interface Props {
  title?: string;
  description?: string;
  /** Which internal nav item is the current page, e.g. 'publications'. */
  active?: string;
  /** Kept for page compatibility; the header no longer hides the name. */
  hideMarkUntilScroll?: boolean;
  /** Keep a page out of search engines without removing it from the site (e.g. the /puzzles/ easter egg). */
  noindex?: boolean;
  /** Share-preview image, a path under public/ (defaults to the avatar). */
  image?: string;
  /** Open Graph type: 'article' for papers/news, 'website' otherwise. */
  ogType?: 'website' | 'article' | 'profile';
}
const {
  title,
  description = site.tagline,
  active,
  noindex = false,
  image = site.avatar,
  ogType = 'website',
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
// Absolute URLs for crawlers and link previews, built from `site` in astro.config.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.replace(/^\/+/, ''), new URL(import.meta.env.BASE_URL, Astro.site)).href;
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;

const nav = [
  { name: 'Home', href: base, key: 'home' },
  { name: 'News', href: `${base}news/`, key: 'news' },
  { name: 'Publications', href: `${base}pubs/`, key: 'publications' },
  { name: 'CV', href: `${base}cv/`, key: 'cv' },
];
const current = active ?? (Astro.url.pathname === base ? 'home' : undefined);
// Top-level section of the site ('news', 'pubs', 'cv', …), used to give each
// section's page header its own colour block.
const section = Astro.url.pathname.slice(base.length).split('/')[0] || 'home';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        // Colour scheme: the system setting by default (pure CSS, below). A
        // choice made in the footer switch is stored and applied before first
        // paint so there's no flash of the other palette.
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion');
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* A sub-path preview build must never compete with the live site in search. */}
    {(noindex || base !== '/') && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <!-- Link previews (Open Graph + Twitter/X, Bluesky, LinkedIn, Slack …). -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <!-- Page-specific metadata (e.g. Google Scholar tags, JSON-LD). -->
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #efeee9;          /* paper */
        --ink: #161616;
        --muted: #6e6d68;
        --line: #d6d4cd;
        /* The one colour. A deep teal, a darker take on the sage/teal of the
           desktop wallpaper the palette came from. Dark enough to read as
           text on the paper (4.8:1); the dark theme uses a lighter shade. */
        --accent: #1c7466;
        --font: 'Archivo Variable', 'Helvetica Neue', Arial, sans-serif;

        /* Legacy tokens still used by the inner pages (news, pubs, cv,
           puzzles, books, music). Mapped onto the new palette so those pages
           stay readable until they get their own pass. */
        --surface: var(--bg);
        --serif: var(--font);
        --sans: var(--font);
        --mono: var(--font);
        --tone: var(--ink);
        --tone-soft: var(--muted);
        --p-red-bg: #f3dcd6;  --p-red-fg: #a23a28;
        --p-blue-bg: #dce6ee; --p-blue-fg: #2d5a7b;
        --p-green-bg: #e1e8dc;--p-green-fg: #3f6436;
        --p-yellow-bg:#f6ecc0;--p-yellow-fg:#7d6200;
        --heat-1: color-mix(in srgb, var(--accent) 28%, var(--bg)); --heat-2: color-mix(in srgb, var(--accent) 52%, var(--bg)); --heat-3: color-mix(in srgb, var(--accent) 76%, var(--bg));
      }
      /* Dark palette. Applied when the visitor picked Dark in the footer
         switch, or (with no choice stored) when the system asks for dark.
         Anything that reports no preference gets the light palette above.
         The two blocks must stay identical. */
      html[data-theme='dark'] {
        color-scheme: dark;
        --bg: #141413;
        --ink: #ecebe6;
        --muted: #8f8e88;
        --line: #2e2d2a;
        --accent: #2f9a88;
        --p-red-bg: #3a2420;  --p-red-fg: #eea596;
        --p-blue-bg: #1d2b36; --p-blue-fg: #9cc0dc;
        --p-green-bg:#1f2a1c; --p-green-fg:#a5c99a;
        --p-yellow-bg:#332b0e;--p-yellow-fg:#e9c21a;
      }
      @media (prefers-color-scheme: dark) {
        html:not([data-theme='light']) {
          color-scheme: dark;
          --bg: #141413;
          --ink: #ecebe6;
          --muted: #8f8e88;
          --line: #2e2d2a;
          --accent: #2f9a88;
          --p-red-bg: #3a2420;  --p-red-fg: #eea596;
          --p-blue-bg: #1d2b36; --p-blue-fg: #9cc0dc;
          --p-green-bg:#1f2a1c; --p-green-fg:#a5c99a;
          --p-yellow-bg:#332b0e;--p-yellow-fg:#e9c21a;
        }
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; }
      html { scrollbar-gutter: stable; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font);
        font-size: 17px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .2em; }
      a:hover { text-decoration-thickness: 2px; }
      img { max-width: 100%; height: auto; display: block; }
      ::selection { background: var(--accent); color: #fff; }
      :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

      .wrap { max-width: 78rem; margin: 0 auto; padding: 0 clamp(1.25rem, 3vw, 2.25rem); }

      /* ---- header ----
         Two small corner blocks, like the credits on a poster: who on the
         left, where to go on the right. No rule, no big wordmark. */
      header.top .inner {
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 1rem 2rem; padding: 1.5rem 0; font-size: .9rem; line-height: 1.35;
      }
      .mark { text-decoration: none; }
      .mark span { display: block; color: var(--muted); }
      nav.links { display: flex; gap: .2rem 1.4rem; flex-wrap: wrap; justify-content: flex-end; }
      nav.links a { text-decoration: none; color: var(--muted); }
      nav.links a:hover { color: var(--ink); }
      nav.links a[aria-current='page'] { color: var(--ink); }
      nav.links a[aria-current='page']::before {
        content: ""; display: inline-block; width: .5em; height: .5em;
        margin-right: .4em; background: var(--accent); vertical-align: .08em;
      }
      /* Menu: on wide screens the <details> is a passthrough (its box is
         removed and the summary hidden) so the links sit inline. On phones it
         becomes a two-line hamburger that drops the links down as a plain
         list under the header. Modern engines wrap closed <details> content
         in ::details-content, which display:contents does not defeat, so it
         is forced visible on wide screens. */
      .menu { display: contents; }
      .menu > summary { display: none; }
      .menu::details-content { content-visibility: visible; }

      @media (max-width: 600px) {
        header.top { position: relative; }
        header.top .inner { align-items: center; }
        .menu { display: block; }
        .menu > summary {
          display: grid; place-items: center; width: 36px; height: 36px; margin-right: -6px;
          list-style: none; cursor: pointer; color: var(--ink);
        }
        .menu > summary::-webkit-details-marker { display: none; }
        .menu svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; }
        .menu .i-close, .menu[open] .i-open { display: none; }
        .menu[open] .i-close { display: block; }
        .menu nav.links { display: none; }
        .menu[open] nav.links {
          display: flex; flex-direction: column; align-items: flex-end; gap: .1rem;
          position: absolute; left: 0; right: 0; top: 100%; z-index: 20;
          padding: .4rem clamp(1.25rem, 3vw, 2.25rem) 1.4rem;
          background: var(--bg); border-bottom: 1px solid var(--line);
          font-size: 1.15rem; animation: menu-in .35s cubic-bezier(.22, .61, .36, 1);
        }
        .menu[open] nav.links a { padding: .3rem 0; }
      }
      @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
      @media (prefers-reduced-motion: reduce) { .menu[open] nav.links { animation: none; } }

      /* ---- shared page grid ----
         Every page is a stack of the same two-column rows: a narrow left
         column for small labels (or the portrait), a wide right column where
         all text starts on one vertical line. */
      .row {
        display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        --col-gap: clamp(2rem, 6vw, 6rem);
        column-gap: var(--col-gap);
        padding: 1.6rem 0; border-top: 1px solid var(--line);
      }
      .row > * { min-width: 0; }
      .label { font-size: .9rem; font-weight: 400; color: var(--muted); margin: .2rem 0 0; }
      .label a { margin-left: .6rem; color: var(--muted); }
      .label a:hover { color: var(--ink); }

      /* Page header on inner pages: big title in the right column. */
      .row.page-head { border-top: 0; padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(2rem, 5vw, 3.5rem); }
      .page-title, .lede {
        font-size: clamp(1.75rem, 3.4vw, 2.85rem); font-weight: 400; line-height: 1.15;
        letter-spacing: -.02em; margin: 0; max-width: 17em;
      }
      .page-intro { color: var(--muted); margin: 1rem 0 0; max-width: 34em; }

      /* Header blocks: on section pages the empty left column of the page
         header holds one flat accent block, echoing the one behind the
         homepage portrait. Each section gets its own size and position, and
         each reaches across the gutter to just touch or tuck under the start
         of the title, so the pages feel set by hand rather than stamped from
         one template. Text never moves: only the blocks are off the grid.
           --bw/--bh  size        --bt/--bb  offset from top / bottom
           --bo       how far past the gutter it reaches under the title */
      .row.page-head { isolation: isolate; position: relative; z-index: 1; }
      .row.page-head > div:first-child:empty { position: relative; }
      .row.page-head > div:first-child:empty::before {
        content: ""; position: absolute; z-index: -1; background: var(--accent);
        width: var(--bw, 3rem); height: var(--bh, 3rem);
        top: var(--bt, auto); bottom: var(--bb, auto);
        right: calc(-1 * var(--col-gap) - var(--bo, 0rem));
        box-shadow: var(--bs, none);
        transition: translate 1.4s cubic-bezier(.22, .61, .36, 1) .3s;
      }
      [data-section='news']    .page-head { --bw: 4.5rem; --bh: 4.5rem; --bt: -1.4rem; --bo: .3rem; }
      [data-section='pubs']    .page-head { --bw: 1.5rem; --bh: 11rem; --bt: -2.5rem; --bo: -.4rem; }
      [data-section='cv']      .page-head { --bw: 15rem; --bh: .6rem; --bt: 3.1rem; --bo: 1.6rem; }
      /* Books: two spines on a shelf. */
      [data-section='books']   .page-head { --bw: 1.15rem; --bh: 4.4rem; --bt: -1.2rem; --bo: -.7rem; --bs: -1.55rem .7rem 0 var(--accent); }
      /* Music: hangs down across the hairline below the header. */
      [data-section='music']   .page-head { --bw: 7rem; --bh: 2.8rem; --bb: calc(-1 * clamp(2rem, 5vw, 3.5rem) - 1.4rem); --bo: -1rem; }
      /* Puzzles: three cells of a 2×2 grid, one left open. */
      [data-section='puzzles'] .page-head {
        --bw: 2.1rem; --bh: 2.1rem; --bt: -.3rem; --bo: -1.75rem;
        --bs: 2.45rem 0 var(--accent), 0 2.45rem var(--accent);
      }
      /* Same print-layer landing as the homepage block. */
      html.motion .row.page-head:not(.is-in) > div:first-child:empty::before { translate: 10px 10px; }
      @media (prefers-reduced-motion: reduce) {
        .row.page-head > div:first-child:empty::before { transition: none; }
      }

      .body { margin: 0; font-size: clamp(1.02rem, 1.4vw, 1.15rem); line-height: 1.5; max-width: 38em; }
      .body a, .prose a { text-decoration-color: var(--muted); }
      .body a:hover, .prose a:hover { text-decoration-color: var(--accent); }

      /* Dated list: a narrow meta column (date / year) and the item. */
      .list { list-style: none; margin: 0; padding: 0; max-width: 42em; }
      .list > li {
        display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem;
        padding: .2rem 0 .7rem;
      }
      .list .meta { color: var(--muted); font-size: .9rem; padding-top: .1rem; font-variant-numeric: tabular-nums; }
      .list a { text-decoration: none; }
      .list a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
      .list .sub { display: block; color: var(--muted); font-size: .9rem; margin-top: .1rem; }

      /* Long-form text (news posts, abstracts). */
      .prose { font-size: 1.08rem; line-height: 1.65; max-width: 38em; }
      .prose > :first-child { margin-top: 0; }
      .prose h2, .prose h3 { font-size: 1.15rem; font-weight: 500; margin: 2rem 0 .5rem; }
      .prose img { margin: 1.5rem 0; }
      .prose blockquote { margin: 1.2rem 0; padding-left: 1rem; border-left: 2px solid var(--accent); color: var(--muted); }
      .prose code { font-size: .9em; }

      /* Emphasised part of a news title (set per item in front matter). */
      .hl { font-style: normal; color: var(--accent); }

      .back { font-size: .9rem; color: var(--muted); text-decoration: none; }
      .back:hover { color: var(--ink); }

      @media (max-width: 760px) {
        .row { grid-template-columns: 1fr; row-gap: .5rem; }
        /* One column: the block sits above the title at a smaller scale
           (--bm), clear of the text. --bvh is a block's visible height when
           a shadow copy extends it; --bl-m shifts it right when a copy sits
           to its left. */
        .row.page-head > div:first-child:empty {
          height: calc(var(--bvh, var(--bh, 3rem)) * var(--bm, .55)); margin-bottom: .6rem;
        }
        .row.page-head > div:first-child:empty::before {
          top: 0; bottom: auto; right: auto; left: var(--bl-m, 0rem);
          scale: var(--bm, .55); transform-origin: 0 0;
        }
        [data-section='pubs']    .page-head { --bm: .3; }
        [data-section='books']   .page-head { --bvh: 5.1rem; --bl-m: .9rem; }
        [data-section='puzzles'] .page-head { --bvh: 4.55rem; }
      }

      /* ---- soft landing ----
         Anything marked [data-reveal] starts slightly transparent and a few
         pixels low, and eases into place when it enters the viewport. Kept
         small on purpose: it should feel like the page settling, not like an
         animation. Only active when JS runs and motion is allowed (.motion). */
      html.motion [data-reveal] {
        opacity: 0; transform: translateY(12px);
        transition: opacity .9s cubic-bezier(.22, .61, .36, 1), transform .9s cubic-bezier(.22, .61, .36, 1);
        transition-delay: var(--reveal-delay, 0ms);
      }
      html.motion [data-reveal].is-in { opacity: 1; transform: none; }
      @media print { html.motion [data-reveal] { opacity: 1; transform: none; } }

      /* ---- footer ---- */
      footer { margin-top: clamp(4rem, 10vw, 8rem); }
      footer .row {
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 2rem;
        padding: 1.4rem 0 2.5rem; border-top: 1px solid var(--ink);
        font-size: .875rem; color: var(--muted);
      }
      footer a { text-decoration: none; }
      footer a:hover { color: var(--ink); text-decoration: underline; }
      footer .flinks { display: flex; gap: 1.2rem; flex-wrap: wrap; }
      footer .fmeta { display: flex; gap: .5rem 2rem; flex-wrap: wrap; }
      /* Colour scheme switch: three plain words, the active one in ink. */
      .theme-switch { display: inline-flex; gap: .7rem; }
      .theme-switch[hidden] { display: none; }
      .theme-switch button {
        font: inherit; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer;
      }
      .theme-switch button:hover { color: var(--ink); }
      .theme-switch button[aria-pressed='true'] { color: var(--ink); }
    </style>
  </head>
  <body data-section={section}>
    <header class="top">
      <div class="wrap">
        <div class="inner">
          <a class="mark" href={base}>{site.name}<span>{site.role}, {site.university}</span></a>
          <details class="menu">
            <summary aria-label="Menu">
              <svg class="i-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
              <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
            </summary>
            <nav class="links" aria-label="Main">
              {nav.map((l) => (
                <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.name}</a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <slot />

    <footer>
      <div class="wrap">
        <div class="row">
          <span class="fmeta">
            <span>© {year} {site.name}</span>
            <span class="theme-switch" role="group" aria-label="Colour scheme" hidden>
              <button type="button" data-theme-choice="auto" aria-pressed="true">Auto</button>
              <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
              <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
            </span>
          </span>
          <span class="flinks">
            {site.socials.map((s) => <a href={s.url}>{s.name}</a>)}
          </span>
        </div>
      </div>
    </footer>

    <script>
      // Soft landing: reveal [data-reveal] blocks as they scroll into view,
      // strictly top to bottom. Blocks reveal as one queue: when any block
      // becomes due, every unrevealed block above it is revealed too, and
      // each one starts STEP ms after the previous one started, however the
      // reveals were batched (first view, fast scroll, restored scroll on
      // refresh). Blocks already scrolled past above the viewport take no
      // slot in the queue, since nobody sees them settle.
      // Fallback: without IntersectionObserver or a real viewport (some
      // embedded/headless views), never leave content hidden.
      if (!('IntersectionObserver' in window) || window.innerHeight === 0) {
        document.documentElement.classList.remove('motion');
      }
      if (document.documentElement.classList.contains('motion')) {
        const STEP = 90;
        const items = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
        let done = 0;      // items[0..done) are revealed
        let nextSlot = 0;  // earliest time (performance.now) the next visible block may start
        const revealThrough = (last: number) => {
          const now = performance.now();
          for (; done <= last; done++) {
            const el = items[done];
            io.unobserve(el);
            let delay = 0;
            if (el.getBoundingClientRect().bottom > 0) {
              delay = Math.max(0, nextSlot - now);
              nextSlot = now + delay + STEP;
            }
            el.style.setProperty('--reveal-delay', `${Math.round(delay)}ms`);
            el.classList.add('is-in');
          }
        };
        const revealUpTo = (due: Element[]) => {
          const last = Math.max(-1, ...due.map((el) => items.indexOf(el as HTMLElement)));
          if (last >= done) revealThrough(last);
        };
        const io = new IntersectionObserver((entries) => {
          // Visible now, or already scrolled past (a jump to the bottom, a
          // restored scroll position): either way it belongs on screen.
          revealUpTo(entries
            .filter((e) => e.isIntersecting || e.boundingClientRect.bottom < 0)
            .map((e) => e.target));
        }, { rootMargin: '0px 0px -8% 0px' });
        // A fast jump can skip a block without it ever intersecting; sweep
        // anything above the fold whenever the user scrolls.
        addEventListener('scroll', () => {
          revealUpTo(items.filter((el) => el.getBoundingClientRect().top < window.innerHeight));
        }, { passive: true });
        for (const el of items) io.observe(el);
      }

      // Colour scheme switch (footer). Auto clears the stored choice so the
      // site follows the system again; Light/Dark are remembered per device.
      // Hidden without JS, where it couldn't work anyway.
      const themeSwitch = document.querySelector<HTMLElement>('.theme-switch');
      if (themeSwitch) {
        const buttons = [...themeSwitch.querySelectorAll<HTMLButtonElement>('button')];
        const sync = () => {
          const current = document.documentElement.getAttribute('data-theme') ?? 'auto';
          for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.themeChoice === current));
        };
        for (const b of buttons) {
          b.addEventListener('click', () => {
            const choice = b.dataset.themeChoice;
            if (choice === 'light' || choice === 'dark') {
              document.documentElement.setAttribute('data-theme', choice);
              try { localStorage.setItem('theme', choice); } catch (e) {}
            } else {
              document.documentElement.removeAttribute('data-theme');
              try { localStorage.removeItem('theme'); } catch (e) {}
            }
            sync();
          });
        }
        sync();
        themeSwitch.hidden = false;
      }

      // Mobile menu: close on Escape or a click outside it.
      const menu = document.querySelector<HTMLDetailsElement>('details.menu');
      if (menu) {
        addEventListener('keydown', (e) => { if (e.key === 'Escape') menu.open = false; });
        addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
      }
    </script>
  </body>
</html>
