---
// Shared shell for every page: <head> + design tokens + header + footer.
// Deliberately plain: paper background, one grotesk (Archivo), small corner
// header. The one loud element lives on
// the homepage (the colour block behind the portrait).
import { site } from '../site.config';
import { hasPublishedNotes } from '../lib/notes';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/archivo/wght-italic.css';

interface Props {
  title?: string;
  description?: string;
  /** Which internal nav item is the current page, e.g. 'publications'. */
  active?: string;
  /** Kept for page compatibility; the header no longer hides the name. */
  hideMarkUntilScroll?: boolean;
  /** Keep a page out of search engines without removing it from the site (e.g. the /puzzles/ easter egg). */
  noindex?: boolean;
  /** Share-preview image, a path under public/ (defaults to the wide site image). */
  image?: string;
  /** Whether `image` is wide (about 1.91:1); picks the large Twitter/X card. */
  imageWide?: boolean;
  /** Open Graph type: 'article' for papers/news, 'website' otherwise. */
  ogType?: 'website' | 'article' | 'profile';
}
const {
  title,
  description = site.tagline,
  active,
  noindex = false,
  image = site.ogImage,
  imageWide = image === site.ogImage,
  ogType = 'website',
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
// Absolute URLs for crawlers and link previews, built from `site` in astro.config.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.replace(/^\/+/, ''), new URL(import.meta.env.BASE_URL, Astro.site)).href;
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;

// "Notes" joins the nav by itself once the first note is published.
const showNotes = await hasPublishedNotes();
const notesItem = showNotes ? [{ name: 'Notes', href: `${base}notes/`, key: 'notes' }] : [];
// The work side's door: "Personal", landing on the notes (or, before the
// first note, the puzzles).
const personalDoor = { name: 'Personal', href: showNotes ? `${base}notes/` : `${base}puzzles/`, key: 'personal' };
// Each side has its own nav, with one door to the other side as its last
// item: Personal from the work pages, Work from the personal ones.
const workNav = [
  { name: 'Home', href: base, key: 'home' },
  { name: 'News', href: `${base}news/`, key: 'news' },
  { name: 'Publications', href: `${base}pubs/`, key: 'publications' },
  { name: 'CV', href: `${base}cv/`, key: 'cv' },
  personalDoor,
];
const personalNav = [
  ...notesItem,
  { name: 'Puzzles', href: `${base}puzzles/`, key: 'puzzles' },
  { name: 'Books', href: `${base}books/`, key: 'books' },
  { name: 'Music', href: `${base}music/`, key: 'music' },
  { name: 'Work', href: base, key: 'work' },
];
const section = Astro.url.pathname.slice(base.length).split('/')[0];
const current = active ?? (Astro.url.pathname === base ? 'home' : ['puzzles', 'books', 'music'].includes(section) ? section : undefined);

// Work pages (home, news, publications, CV) are on the light palette; the
// personal side (notes and the footer pages) on the swapped one. That's the
// "Auto" of the footer switch; picking Light or Dark there overrides it on
// every page. The subtitle under the name changes with it.
const personal = new RegExp(`^${base}(notes|puzzles|books|music)(/|$)`).test(Astro.url.pathname);
const defaultTheme = personal ? 'dark' : 'light';
const nav = personal ? personalNav : workNav;
// The other side's labels, for the scramble on arrival (see the script).
const otherNav = (personal ? workNav : personalNav).map((l) => l.name);
---

<!doctype html>
<html lang="en" data-theme={defaultTheme} data-default-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Browser chrome in the page colour; the theme script below switches it
         with the footer choice. Keep in sync with --bg. -->
    <meta name="theme-color" content={personal ? '#7d300e' : '#c0d5ee'} />
    <script is:inline>
      (function () {
        // Colour scheme: by default the page's own palette (light for work
        // pages, swapped for personal ones; set on <html> by the server, so it
        // also holds without JS). A choice made in the footer switch is stored
        // and applied before first paint so there's no flash of the other one.
        //
        // The choice is kept in localStorage, a cookie and window.name. Mobile
        // Safari with "Block All Cookies" (and some in-app browsers) throws
        // on localStorage, so it can't be the only place; window.name survives
        // same-tab navigation even when all storage is blocked.
        var ok = function (v) { return v === 'light' || v === 'dark' ? v : null; };
        var store = {
          get: function () {
            try { var l = ok(localStorage.getItem('theme')); if (l) return l; } catch (e) {}
            try { var c = ok((document.cookie.match(/(?:^|; )theme=(\w+)/) || [])[1]); if (c) return c; } catch (e) {}
            return ok((window.name.match(/^theme=(\w+)$/) || [])[1]);
          },
          set: function (v) {
            v = ok(v);
            try { v ? localStorage.setItem('theme', v) : localStorage.removeItem('theme'); } catch (e) {}
            try { document.cookie = 'theme=' + (v || '') + '; path=/; SameSite=Lax; max-age=' + (v ? 31536000 : 0); } catch (e) {}
            if (!window.name || /^theme=/.test(window.name)) window.name = v ? 'theme=' + v : '';
          },
          apply: function () {
            var root = document.documentElement;
            var v = store.get() || root.getAttribute('data-default-theme') || 'light';
            root.setAttribute('data-theme', v);
            var tc = document.querySelectorAll('meta[name="theme-color"]');
            for (var i = 0; i < tc.length; i++) tc[i].content = v === 'dark' ? '#7d300e' : '#c0d5ee';
          },
        };
        window.__theme = store;
        store.apply();
        // Ink spill, second half: the page we came from flooded the screen
        // with this page's paper colour (script at the end of the page). Start
        // covered by it and let it lift (pure CSS, so it lifts even if the
        // page's scripts fail).
        try {
          var ink = JSON.parse(sessionStorage.getItem('ink') || 'null');
          sessionStorage.removeItem('ink');
          if (ink && Date.now() - ink.t < 5000) document.documentElement.classList.add('ink-in');
        } catch (e) {}
        // Ink spill where the browser has cross-page view transitions (Chrome,
        // Safari 18.2+): no flat colour in between, this page itself grows out
        // of the bubble or the click, over the page we came from. The old page
        // left the circle to start from and opted both pages in; every other
        // navigation has no view transition at all.
        try {
          var grow = JSON.parse(sessionStorage.getItem('ink-grow') || 'null');
          sessionStorage.removeItem('ink-grow');
          if (!grow || Date.now() - grow.t > 5000) grow = null;
          if (grow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var opt = document.createElement('style');
            opt.textContent = '@view-transition { navigation: auto; }';
            document.head.appendChild(opt);
          } else grow = null;
          window.addEventListener('pagereveal', function (e) {
            var vt = e.viewTransition;
            if (!vt) return;
            var g = grow;
            grow = null;
            if (!g) {
              // (Catches: Safari reports a skipped transition as an error otherwise.)
              vt.ready.catch(function () {}); vt.finished.catch(function () {}); vt.updateCallbackDone.catch(function () {});
              vt.skipTransition();
              return;
            }
            var r = Math.hypot(Math.max(g.x, innerWidth - g.x), Math.max(g.y, innerHeight - g.y)) + 2;
            var at = 'px at ' + g.x + 'px ' + g.y + 'px)';
            vt.ready.then(function () {
              document.documentElement.animate(
                { clipPath: ['circle(' + g.r0 + at, 'circle(' + r + at] },
                // power2.inOut (MOVE in lib/motion.ts)
                { duration: g.r0 ? 480 : 560, easing: 'cubic-bezier(.45, 0, .55, 1)', pseudoElement: '::view-transition-new(root)' }
              );
            }).catch(function () {});
          });
        } catch (e) {}
        // A page restored from the back/forward cache keeps the theme it had
        // when it was left; re-read the stored choice.
        window.addEventListener('pageshow', function (e) { if (e.persisted) store.apply(); });
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion');
          // Smooth scroll (ScrollSmoother, set up at the end of the page) only
          // with a mouse or trackpad. Decided here, before any page script
          // runs, so components (the scrolly) know whether it will be on.
          // Skipped when the last frame-rate check (lib/motion.ts) found this
          // browser throttled: choppy smoothing is worse than native scroll.
          var slow = false;
          try { slow = localStorage.getItem('smooth-slow') === '1'; } catch (e) {}
          if (window.matchMedia('(pointer: fine)').matches && !slow) {
            document.documentElement.classList.add('smooth');
          }
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* A sub-path preview build must never compete with the live site in search. */}
    {(noindex || base !== '/') && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {showNotes && <link rel="alternate" type="application/rss+xml" title={`Notes · ${site.name}`} href={`${base}notes/rss.xml`} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <!-- Link previews (Open Graph + Twitter/X, Bluesky, LinkedIn, Slack …). -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content={imageWide ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <!-- Page-specific metadata (e.g. Google Scholar tags, JSON-LD). -->
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: light;
        /* Two colours, nothing else: burnt orange ink on grey-blue paper.
           The dark theme swaps them. The orange is the accent too, so
           emphasis comes from weight, not from a third colour. --muted is a
           deep blue (5.5:1, a bit quieter than the text), not a faded orange, so small text stays
           readable. --accent-2 is that grey-blue, for contrast in charts. */
        --bg: #c0d5ee;          /* sky-blue paper */
        --ink: #7d300e;         /* burnt orange, 6.1:1 */
        --muted: #3d5068;
        --line: color-mix(in srgb, var(--ink) 25%, var(--bg));
        --accent: #7d300e;
        --accent-2: #3d5068;
        --font: 'Archivo Variable', 'Helvetica Neue', Arial, sans-serif;

        /* Legacy tokens still used by the inner pages (news, pubs, cv,
           puzzles, books, music). Mapped onto the new palette so those pages
           stay readable until they get their own pass. */
        --surface: var(--bg);
        --serif: var(--font);
        --sans: var(--font);
        --mono: var(--font);
        --tone: var(--ink);
        --tone-soft: var(--muted);
        --p-red-bg: #d6c3bd;  --p-red-fg: #7a2c0c;
        --p-blue-bg: #a9b7c4; --p-blue-fg: #2f4a63;
        --p-green-bg: #b9c5b8;--p-green-fg: #3d5530;
        --p-yellow-bg:#cdc6b4;--p-yellow-fg:#6b4e0e;
        --heat-1: color-mix(in srgb, var(--accent) 28%, var(--bg)); --heat-2: color-mix(in srgb, var(--accent) 52%, var(--bg)); --heat-3: color-mix(in srgb, var(--accent) 76%, var(--bg));
      }
      /* Ink spill between work and personal (script at the end of the page):
         the new paper colour floods out from the click (.ink-spill), and the
         next page starts under that same colour, which lifts (.ink-in). */
      .ink-spill { position: fixed; inset: 0; z-index: 2147483646; pointer-events: none; }
      /* Behind everything but the paper itself: it colours the page around
         the link, and the link takes the other side's ink on top of it. */
      .ink-bubble { position: fixed; left: 0; top: 0; z-index: -1; pointer-events: none; }
      .ink-blob { width: 100%; height: 100%; border-radius: 50%; }
      /* The text over the bubble: coloured by a gradient that follows it. */
      .ink-lens { -webkit-background-clip: text; background-clip: text; color: transparent !important; }
      .mark { position: relative; }
      .mark-sub-lens { position: absolute; white-space: nowrap; pointer-events: none; }
      /* Cross-page view transition for the ink spill (head script): only
         switched on for a click to the other side (a <style> with
         @view-transition on both pages), so every other link loads as usual. */
      ::view-transition-old(root), ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
      html.ink-in::before {
        content: ''; position: fixed; inset: 0; z-index: 2147483646; pointer-events: none;
        background: var(--bg); animation: ink-lift .4s cubic-bezier(.4, 0, .2, 1) .08s forwards;
      }
      @keyframes ink-lift { to { opacity: 0; visibility: hidden; } }
      /* Swapped ("dark") palette: the personal pages by default, or every
         page when the visitor picked Dark in the footer switch. */
      html[data-theme='dark'] {
        color-scheme: dark;
        --bg: #7d300e;
        --ink: #c0d5ee;
        --muted: #e6c2ad;
        --line: color-mix(in srgb, var(--ink) 28%, var(--bg));
        --accent: #c0d5ee;
        --accent-2: #f0c9b2;
        --p-red-bg: #6f2a0c;  --p-red-fg: #f6d2bd;
        --p-blue-bg: #6e4a3f; --p-blue-fg: #dbe6ef;
        --p-green-bg:#6b4a22; --p-green-fg:#d6e4c0;
        --p-yellow-bg:#7a4a12;--p-yellow-fg:#f3d79c;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; }
      html { scrollbar-gutter: stable; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font);
        font-size: 17px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      /* Noise texture (Resource Boy 005) over the paper. It sits inside
         #smooth-content, so ScrollSmoother's transform carries it along with
         the page instead of leaving it on the native scroll position. The transform
         isolates blending, so the tile is baked as black/white with alpha
         (dark pixels black, light pixels white) rather than a blend mode. */
      #smooth-content { position: relative; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }
      /* Short pages (notes on tall, narrow screens): the footer stays at the
         bottom of the viewport; the space goes above it. */
      #smooth-content > footer { margin-top: auto; padding-top: clamp(4rem, 10vw, 8rem); }
      #smooth-content::before {
        content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
        background: url(/noise.png) 0 0 / 256px 256px; opacity: .35;
      }
      /* The grain sits under the content, on the paper only; the coloured
         squares get their own copy, and text and photos stay clean. */
      .block::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background: url(/noise.png) 0 0 / 256px 256px; opacity: .35;
      }
      html[data-theme="dark"] .block::after { display: none; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .2em; }
      a:hover { text-decoration-thickness: 2px; }
      /* Hover states appear at once and ease back when the pointer leaves:
         a soft fade-out that should hardly register. */
      a, button, .feature-title, .rank-title {
        transition: color .3s ease-out, text-decoration-color .3s ease-out, text-decoration-thickness .3s ease-out;
      }
      a:hover, button:hover, a:hover .feature-title, a:hover .rank-title { transition-duration: 0s; }
      @media (prefers-reduced-motion: reduce) {
        a, button, .feature-title, .rank-title { transition: none; }
      }
      img { max-width: 100%; height: auto; display: block; }
      ::selection { background: var(--ink); color: var(--bg); }
      :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

      .wrap { width: 100%; max-width: 78rem; margin: 0 auto; padding: 0 clamp(1.25rem, 3vw, 2.25rem); }

      /* ---- header ----
         Two small corner blocks, like the credits on a poster: who on the
         left, where to go on the right. No rule, no big wordmark. */
      header.top .inner {
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 1rem 2rem; padding: 1.5rem 0; font-size: .9rem; line-height: 1.35;
      }
      .mark { text-decoration: none; }
      .mark-sub { display: block; color: var(--muted); }
      nav.links { display: flex; gap: .2rem 1.4rem; flex-wrap: wrap; justify-content: flex-end; }
      nav.links a { text-decoration: none; color: var(--muted); }
      nav.links a:hover { color: var(--ink); }
      nav.links a[aria-current='page'] { color: var(--ink); }
      nav.links a[aria-current='page']::before {
        content: ""; display: inline-block; width: .5em; height: .5em;
        margin-right: .4em; background: var(--accent); vertical-align: .08em;
      }
      /* Menu: on wide screens the <details> is a passthrough (its box is
         removed and the summary hidden) so the links sit inline. On phones it
         becomes a two-line hamburger that drops the links down as a plain
         list under the header. Modern engines wrap closed <details> content
         in ::details-content, which display:contents does not defeat, so it
         is forced visible on wide screens. */
      .menu { display: contents; }
      .menu > summary { display: none; }
      .menu::details-content { content-visibility: visible; }

      @media (max-width: 600px) {
        header.top { position: relative; }
        header.top .inner { align-items: center; }
        .menu { display: block; }
        .menu > summary {
          display: grid; place-items: center; width: 36px; height: 36px; margin-right: -6px;
          list-style: none; cursor: pointer; color: var(--ink);
        }
        .menu > summary::-webkit-details-marker { display: none; }
        .menu svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; }
        .menu .i-close, .menu[open] .i-open { display: none; }
        .menu[open] .i-close { display: block; }
        .menu nav.links { display: none; }
        .menu[open] nav.links {
          display: flex; flex-direction: column; align-items: flex-end; gap: .1rem;
          position: absolute; left: 0; right: 0; top: 100%; z-index: 20;
          padding: .4rem clamp(1.25rem, 3vw, 2.25rem) 1.4rem;
          background: var(--bg); border-bottom: 1px solid var(--line);
          font-size: 1.15rem; animation: menu-in .35s cubic-bezier(.22, .61, .36, 1);
        }
        .menu[open] nav.links a { padding: .3rem 0; }
      }
      @keyframes menu-in { from { opacity: 0; transform: translateY(-6px); } }
      @media (prefers-reduced-motion: reduce) { .menu[open] nav.links { animation: none; } }

      /* ---- shared page grid ----
         Every page is a stack of the same two-column rows: a narrow left
         column for small labels (or the portrait), a wide right column where
         all text starts on one vertical line. */
      .row {
        display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        column-gap: clamp(2rem, 6vw, 6rem);
        padding: 1.6rem 0; border-top: 1px solid var(--line);
      }
      .row > * { min-width: 0; }
      .label { font-size: .9rem; font-weight: 400; color: var(--muted); margin: .2rem 0 0; }
      .label a { margin-left: .6rem; color: var(--muted); }
      .label a:hover { color: var(--ink); }

      /* Page header on inner pages: big title in the right column. */
      .row.page-head { border-top: 0; padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(2rem, 5vw, 3.5rem); }
      .page-title, .lede {
        font-size: clamp(1.75rem, 3.4vw, 2.85rem); font-weight: 400; line-height: 1.15;
        letter-spacing: -.02em; margin: 0; max-width: 17em;
      }
      .page-intro { color: var(--muted); margin: 1rem 0 0; max-width: 34em; }
      /* Colour words in notes ("orange marks…"), see components/notes/Hue.astro.
         "teal" and "rust" are the old names, kept so older text still works. */
      .hue { font-weight: 600; }
      .hue.accent { color: var(--accent); }
      .hue.accent-2 { color: var(--accent-2); }
      /* Colour words carry both names; show the one for the theme. */
      .hue-d { display: none; }
      html[data-theme='dark'] .hue-l { display: none; }
      html[data-theme='dark'] .hue-d { display: inline; }

      .body { margin: 0; font-size: clamp(1.02rem, 1.4vw, 1.15rem); line-height: 1.5; max-width: 38em; }
      .body a, .prose a { text-decoration-color: var(--muted); }
      .body a:hover, .prose a:hover { text-decoration-color: var(--accent); }

      /* Dated list: a narrow meta column (date / year) and the item. */
      .list { list-style: none; margin: 0; padding: 0; max-width: 42em; }
      .list > li {
        display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 1rem;
        padding: .2rem 0 .7rem;
      }
      .list .meta { color: var(--muted); font-size: .9rem; padding-top: .1rem; font-variant-numeric: tabular-nums; }
      /* Underline kept but transparent, so it can fade out after hover. */
      .list a { text-decoration-line: underline; text-decoration-color: transparent; }
      .list a:hover { text-decoration-color: var(--accent); }
      .list .sub { display: block; color: var(--muted); font-size: .9rem; margin-top: .1rem; }

      /* Long-form text (news posts, abstracts). */
      .prose { font-size: 1.08rem; line-height: 1.65; max-width: 38em; }
      .prose > :first-child { margin-top: 0; }
      .prose h2, .prose h3 { font-size: 1.15rem; font-weight: 500; margin: 2rem 0 .5rem; }
      .prose img { margin: 1.5rem 0; }
      .prose blockquote { margin: 1.2rem 0; padding-left: 1rem; border-left: 2px solid var(--accent); color: var(--muted); }
      .prose code { font-size: .9em; }

      /* Emphasised part of a news title (set per item in front matter). */
      .hl { font-style: normal; color: var(--accent); }

      .back { font-size: .9rem; color: var(--muted); text-decoration: none; }
      .back:hover { color: var(--ink); }

      @media (max-width: 760px) {
        .row { grid-template-columns: 1fr; row-gap: .5rem; }
      }

      /* ---- soft landing ----
         Anything marked [data-reveal] starts slightly transparent and a few
         pixels low, and eases into place when it enters the viewport. Kept
         small on purpose: it should feel like the page settling, not like an
         animation. Only active when JS runs and motion is allowed (.motion). */
      /* GSAP (script below) animates them in and adds .is-in as they start. */
      html.motion :is([data-reveal], .prose-reveal > :not([data-reveal])):not(.is-in) { opacity: 0; transform: translateY(12px); }
      @media print { html.motion :is([data-reveal], .prose-reveal > *) { opacity: 1; transform: none; } }

      /* ---- footer ---- */
      footer { margin-top: clamp(4rem, 10vw, 8rem); }
      footer .row {
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 2rem;
        padding: 1.4rem 0 2.5rem; border-top: 1px solid var(--ink);
        font-size: .875rem; color: var(--muted);
      }
      footer a { text-decoration-line: underline; text-decoration-color: transparent; }
      footer a:hover { color: var(--ink); text-decoration-color: currentColor; }
      footer .flinks { display: flex; gap: 1.2rem; flex-wrap: wrap; }
      footer .fmeta { display: flex; gap: .5rem 2rem; flex-wrap: wrap; }
      /* Phones: one three-column grid for the whole footer, on the page's own
         lines. Column 1 is the 5.5rem date column of the lists above, so
         column 2 starts where their text does; column 3 is shared by the
         theme switch and the last link of each row. A hairline (::after)
         separates the © line from the links. */
      @media (max-width: 600px) {
        footer .row {
          display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 6.5rem; gap: .7rem 1rem;
        }
        footer .fmeta, footer .flinks { display: contents; }
        footer .flinks a, footer .fmeta > :first-child { white-space: nowrap; }
        footer .flinks .full { display: none; }
        footer .fmeta > :first-child { grid-column: 1 / 3; }
        footer .theme-switch { grid-column: 3; width: 6.5rem; justify-content: space-between; gap: 0; }
        footer .row::after {
          content: ""; grid-row: 2; grid-column: 1 / -1; height: 1px; margin: .3rem 0; background: var(--line);
        }
      }
      /* Too narrow for © and the switch side by side: the switch drops to
         its own line, still in column 3. */
      @media (max-width: 349px) {
        footer .fmeta > :first-child { grid-column: 1 / -1; }
        footer .theme-switch { grid-row: 2; grid-column: 1 / -1; justify-self: end; }
        footer .row::after { grid-row: 3; }
      }
      footer .flinks .short { display: none; }
      @media (max-width: 600px) { footer .flinks .short { display: inline; } }
      /* Colour scheme switch: three plain words, the active one in ink. */
      .theme-switch { display: inline-flex; gap: .7rem; }
      .theme-switch[hidden] { display: none; }
      .theme-switch button {
        font: inherit; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer;
      }
      .theme-switch button:hover { color: var(--ink); }
      .theme-switch button[aria-pressed='true'] { color: var(--ink); }
    </style>
  </head>
  <body>
    <!-- ScrollSmoother (trial): everything that scrolls sits in these two
         wrappers. Anything position:fixed must live outside them. -->
    <div id="smooth-wrapper"><div id="smooth-content">
    <header class="top">
      <div class="wrap">
        <div class="inner">
          <a class="mark" href={base}><span class="mark-name">{site.name}</span><span class="mark-sub" data-work={`${site.role}, ${site.university}`} data-personal={site.personalLine}>{personal ? site.personalLine : `${site.role}, ${site.university}`}</span></a>
          <details class="menu">
            <summary aria-label="Menu">
              <svg class="i-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
              <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
            </summary>
            <nav class="links" aria-label="Main" data-other={JSON.stringify(otherNav)}>
              {nav.map((l) => (
                <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.name}</a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <slot />

    <footer>
      <div class="wrap">
        <div class="row">
          <span class="fmeta">
            <a href={`${base}colophon/`}>© {year} {site.name}</a>
            <span class="theme-switch" role="group" aria-label="Colour scheme" hidden>
              <button type="button" data-theme-choice="auto" aria-pressed="true">Auto</button>
              <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
              <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
            </span>
          </span>
          <span class="flinks">
            {site.socials.map((s) => (
              <a href={s.url}>
                {'short' in s ? <><span class="full">{s.name}</span><span class="short">{s.short}</span></> : s.name}
              </a>
            ))}
          </span>
        </div>
      </div>
    </footer>
    </div></div>

    <script>
      import { gsap, ScrollTrigger, MOVE, LEAVE } from '../lib/motion';
      import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';
      import { InertiaPlugin } from 'gsap/InertiaPlugin';
      gsap.registerPlugin(ScrambleTextPlugin, InertiaPlugin);

      // ---- Work <-> personal: ink bubble, spill + scrambled subtitle --------
      // A link to the other side (work: home, news, pubs, CV; personal: notes,
      // puzzles, books, music) gets, on hover, a bubble of the other side's
      // paper behind it, with the link in that side's ink: a preview. On click
      // the bubble spills over the screen; the next page starts under that
      // colour (see .ink-in) and the line under the name scrambles from the
      // old side's text into the new one. Without hover (touch) the spill
      // starts from the tap. Within one side, or with reduced motion, links
      // just work as links.
      const root = document.documentElement;
      const theme = (window as any).__theme;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const PAPER: Record<string, string> = { light: '#c0d5ee', dark: '#7d300e' };
      const INK: Record<string, string> = { light: '#7d300e', dark: '#c0d5ee' };
      const PERSONAL = new RegExp(`^${import.meta.env.BASE_URL}(notes|puzzles|books|music)(/|$)`);
      const sideOf = (path: string) => (PERSONAL.test(path) ? 'personal' : 'work');
      const here = sideOf(location.pathname);
      const themeFor = (side: string) => theme.get() ?? (side === 'personal' ? 'dark' : 'light');

      /** Flood the screen with `color` from a circle of radius r0 at (x, y);
       *  `full` runs once covered. Quicker when it grows out of a bubble. */
      const spill = (x: number, y: number, color: string, full: (el: HTMLElement) => void, r0 = 0) => {
        const el = document.createElement('div');
        el.className = 'ink-spill';
        el.style.background = color;
        document.body.append(el);
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + 2;
        // Safety net: if the animation stalls (a throttled tab), go on anyway.
        let done = false;
        const finish = () => { if (!done) { done = true; full(el); } };
        setTimeout(finish, 1100);
        gsap.fromTo(el,
          { clipPath: `circle(${r0}px at ${x}px ${y}px)` },
          { clipPath: `circle(${r}px at ${x}px ${y}px)`, duration: r0 ? 0.42 : 0.5, ease: MOVE, onComplete: finish });
      };

      // Cross-page view transitions (the page grows in, see the head script).
      const crossPage = 'onpagereveal' in window && CSS.supports('selector(::view-transition)');
      // Fetch a cross-side page while its bubble shows, so the click has it
      // ready. Safari has no <link rel=prefetch>: a low-priority fetch fills
      // the HTTP cache instead.
      const fetched = new Set<string>();
      const prefetch = (href: string) => {
        if (fetched.has(href)) return;
        fetched.add(href);
        const link = document.createElement('link');
        if (link.relList.supports?.('prefetch')) {
          Object.assign(link, { rel: 'prefetch', href });
          document.head.append(link);
        } else {
          fetch(href, { priority: 'low' } as RequestInit).catch(() => {});
        }
      };

      /** The palette a link would take us to, or null when it doesn't change it. */
      const nextPaper = (a: HTMLAnchorElement) => {
        if ((a.target && a.target !== '_self') || a.hasAttribute('download')) return null;
        const url = new URL(a.href, location.href);
        if (url.origin !== location.origin || url.pathname === location.pathname) return null;
        if (sideOf(url.pathname) === here) return null;
        const next = themeFor(sideOf(url.pathname));
        return next === root.getAttribute('data-theme') ? null : next;
      };

      // The hover bubble: behind the page's text (z-index -1, see .ink-bubble),
      // big enough to hold the whole link, pulled towards the pointer, and
      // stretched in the direction it moves (InertiaPlugin tracks its speed).
      // Links that lead to the same side share one bubble: moving along the
      // menu, it flows from one to the next instead of popping. Only on short
      // links (menu items and the like) and the name, with a real hover.
      // Text takes the other side's colours only where the bubble is (a
      // colour mask that follows it, see paintText), like a lens. Over the
      // name, the lens also shows the other side's line under it: a copy of
      // the subtitle with that text lies on top of it, visible only inside
      // the bubble (scrambling in), while the real one shows only outside.
      const sub = document.querySelector<HTMLElement>('.mark-sub');
      const MUTED: Record<string, string> = { light: '#3d5068', dark: '#e6c2ad' };
      const subFor = (side: string) => (side === 'personal' ? sub?.dataset.personal : sub?.dataset.work) ?? '';
      const hover = matchMedia('(hover: hover) and (pointer: fine)').matches;
      type Bubble = {
        el: HTMLElement; blob: HTMLElement; a: HTMLAnchorElement; next: string;
        cx: number; cy: number; x: Function; y: Function; drop?: number;
      };
      let bubble: Bubble | null = null;
      const PULL = 0.5; // how far the bubble follows the pointer off the link's centre
      const STRETCH = 0.45; // most it stretches at full speed
      const fit = (a: HTMLAnchorElement) => {
        const box = a.getBoundingClientRect();
        if (!a.classList.contains('mark') && (box.width > 170 || box.height > 48)) return null;
        return { r: Math.max(26, Math.hypot(box.width, box.height) / 2 + 10), cx: box.left + box.width / 2, cy: box.top + box.height / 2 };
      };
      // The text under the bubble: each element with its own colour, the
      // one it has on the other side inside the bubble, its normal one outside.
      let painted: { el: HTMLElement; inside: string; outside: string }[] = [];
      let lensSub: HTMLElement | null = null;
      const enter = (a: HTMLAnchorElement, next: string) => {
        // Mask the link's own text. For the name that's .mark-name, not the
        // whole link: a mask on the link would also paint the subtitles in it.
        const own = a.querySelector<HTMLElement>('.mark-name') ?? a;
        painted = [{ el: own, inside: INK[next], outside: getComputedStyle(own).color }];
        if (a.classList.contains('mark') && sub) {
          const muted = getComputedStyle(sub).color;
          lensSub = document.createElement('span');
          lensSub.className = 'mark-sub-lens';
          lensSub.setAttribute('aria-hidden', 'true');
          lensSub.textContent = sub.textContent;
          lensSub.style.left = `${sub.offsetLeft}px`;
          lensSub.style.top = `${sub.offsetTop}px`;
          a.append(lensSub);
          painted.push({ el: sub, inside: 'transparent', outside: muted }, { el: lensSub, inside: MUTED[next], outside: 'transparent' });
          gsap.to(lensSub, { duration: 0.6, scrambleText: { text: subFor(sideOf(new URL(a.href).pathname)), chars: 'lowerCase', speed: 0.6 } });
        }
        for (const p of painted) p.el.classList.add('ink-lens');
      };
      const leave = (a: HTMLAnchorElement) => {
        for (const p of painted) { p.el.classList.remove('ink-lens'); p.el.style.backgroundImage = ''; }
        painted = [];
        if (lensSub) { gsap.killTweensOf(lensSub); lensSub.remove(); lensSub = null; }
      };
      // Every frame: a circle the size of the bubble (its area, so the
      // stretch roughly matches), at the bubble's centre, in each element's
      // own coordinates (fixed backgrounds don't work under the smooth
      // scroller's transform).
      const paintText = () => {
        if (!bubble || !painted.length) return;
        const b = bubble.el.getBoundingClientRect();
        const bx = b.left + b.width / 2, by = b.top + b.height / 2;
        const sx = +gsap.getProperty(bubble.el, 'scaleX'), sy = +gsap.getProperty(bubble.el, 'scaleY');
        const r = (bubble.el.offsetWidth / 2) * +gsap.getProperty(bubble.blob, 'scale') * Math.sqrt(sx * sy);
        for (const p of painted) {
          const e = p.el.getBoundingClientRect();
          p.el.style.backgroundImage = `radial-gradient(circle ${r}px at ${bx - e.left}px ${by - e.top}px, ${p.inside} ${r}px, ${p.outside} ${r}px)`;
        }
      };
      const dropBubble = () => {
        if (!bubble) return;
        const { el, blob, a } = bubble;
        clearTimeout(bubble.drop);
        bubble = null;
        leave(a);
        gsap.to(blob, { scale: 0, duration: 0.25, ease: LEAVE, onComplete: () => { InertiaPlugin.untrack(el); el.remove(); } });
      };
      const stretch = { sx: 0 as any, sy: 0 as any };
      // A bubble over link `a`, at (x, y) to start with (shared by hover and
      // the tap on touch screens, where it is what the text gradient follows).
      const makeBubble = (a: HTMLAnchorElement, next: string, f: { r: number; cx: number; cy: number }, x: number, y: number, full = false) => {
        dropBubble();
        const el = document.createElement('div');
        el.className = 'ink-bubble';
        el.style.cssText = `width:${f.r * 2}px;height:${f.r * 2}px`;
        const blob = document.createElement('div');
        blob.className = 'ink-blob';
        blob.style.background = PAPER[next];
        el.append(blob);
        document.body.append(el);
        gsap.set(el, { xPercent: -50, yPercent: -50, x: f.cx, y: f.cy, rotation: 0, scaleX: 1, scaleY: 1 });
        if (full) gsap.set(blob, { scale: 1 }); else gsap.fromTo(blob, { scale: 0 }, { scale: 1, duration: 0.35 });
        InertiaPlugin.track(el, 'x,y');
        stretch.sx = gsap.quickTo(el, 'scaleX', { duration: 0.25 });
        stretch.sy = gsap.quickTo(el, 'scaleY', { duration: 0.25 });
        bubble = { el, blob, a, next, cx: f.cx, cy: f.cy, x: gsap.quickTo(el, 'x', { duration: 0.45 }), y: gsap.quickTo(el, 'y', { duration: 0.45 }) };
        bubble.x(x); bubble.y(y);
        enter(a, next);
        paintText(); // at once, so the text is never transparent for a frame
      };
      if (!calm) {
        // Stretch: every frame, point the bubble along its velocity and pull
        // it long in proportion to the speed; round again when it slows.
        gsap.ticker.add(() => {
          if (!bubble) return;
          const { el } = bubble;
          const vx = InertiaPlugin.getVelocity(el, 'x'), vy = InertiaPlugin.getVelocity(el, 'y');
          const speed = Math.hypot(vx, vy);
          const k = Math.min(speed / 1800, 1) * STRETCH;
          if (speed > 30) gsap.set(el, { rotation: (Math.atan2(vy, vx) * 180) / Math.PI });
          stretch.sx(1 + k);
          stretch.sy(1 - k * 0.55);
          paintText();
        });
      }
      if (hover && !calm) {
        document.addEventListener('pointerover', (e) => {
          const a = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
          if (!a) return;
          if (a === bubble?.a) { clearTimeout(bubble.drop); return; }
          const next = nextPaper(a);
          if (next) prefetch(a.href);
          const f = next && fit(a);
          if (!next || !f) return;
          if (bubble && bubble.next === next) {
            // Same destination side: flow over to this link and resize.
            clearTimeout(bubble.drop);
            leave(bubble.a);
            Object.assign(bubble, { a, cx: f.cx, cy: f.cy });
            gsap.to(bubble.el, { width: f.r * 2, height: f.r * 2, duration: 0.45 });
            bubble.x(f.cx + (e.clientX - f.cx) * PULL);
            bubble.y(f.cy + (e.clientY - f.cy) * PULL);
            enter(a, next);
            paintText(); // at once, so the text is never transparent for a frame
            return;
          }
          makeBubble(a, next, f, f.cx + (e.clientX - f.cx) * PULL, f.cy + (e.clientY - f.cy) * PULL);
        });
        document.addEventListener('pointermove', (e) => {
          if (!bubble) return;
          const { cx, cy } = bubble;
          bubble.x(cx + (e.clientX - cx) * PULL);
          bubble.y(cy + (e.clientY - cy) * PULL);
        });
        // Leaving a link: wait a moment, so crossing the gap to the next menu
        // item keeps the same bubble.
        document.addEventListener('pointerout', (e) => {
          if (!bubble || bubble.a.contains(e.relatedTarget as Node)) return;
          if ((e.target as Element).closest?.('a[href]') !== bubble.a) return;
          clearTimeout(bubble.drop);
          bubble.drop = window.setTimeout(dropBubble, 160);
        });
        addEventListener('scroll', dropBubble, { passive: true });
      }
      // Where a click "lands": the pointer, or the middle of the element when
      // it came from the keyboard.
      const origin = (e: MouseEvent, el: Element) => {
        if (e.detail > 0) return [e.clientX, e.clientY];
        const b = el.getBoundingClientRect();
        return [b.left + b.width / 2, b.top + b.height / 2];
      };

      document.addEventListener('click', (e) => {
        if (calm || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
        const url = new URL(a.href, location.href);
        if (url.origin !== location.origin || url.pathname === location.pathname) return;
        if (sideOf(url.pathname) === here) return;
        try { sessionStorage.setItem('side-from', here); } catch {}
        const next = nextPaper(a);
        if (!next) return; // same paper (a Light/Dark choice): only the scramble
        // No hover (touch): make the bubble at the tap now, so the text takes
        // the gradient and the spill grows out of it like on desktop.
        if (bubble?.a !== a && !hover) {
          const f = fit(a);
          if (f) { const [tx, ty] = origin(e, a); makeBubble(a, next, f, f.cx + (tx - f.cx) * PULL, f.cy + (ty - f.cy) * PULL, true); }
        }
        // Grow out of the hover bubble when there is one, else from the click.
        let x: number, y: number, r0 = 0;
        if (bubble?.a === a) {
          const b = bubble.el.getBoundingClientRect();
          [x, y, r0] = [b.left + b.width / 2, b.top + b.height / 2, Math.min(b.width, b.height) / 2];
        } else {
          [x, y] = origin(e, a);
        }
        // With view transitions the next page itself grows out of that
        // circle (head script): let the link just navigate.
        if (crossPage) {
          try {
            sessionStorage.setItem('ink-grow', JSON.stringify({ x, y, r0, t: Date.now() }));
            const opt = document.createElement('style');
            opt.textContent = '@view-transition { navigation: auto; }';
            document.head.append(opt);
            return;
          } catch {}
        }
        e.preventDefault();
        const go = () => {
          try { sessionStorage.setItem('ink', JSON.stringify({ t: Date.now() })); } catch {}
          location.href = url.href;
        };
        spill(x, y, PAPER[next], go, r0);
      });
      // Back/forward cache: the page we left is still flooded; clear it.
      addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        document.querySelectorAll('.ink-spill, .ink-bubble').forEach((el) => el.remove());
        document.querySelectorAll<HTMLElement>('.ink-lens').forEach((el) => { el.classList.remove('ink-lens'); el.style.backgroundImage = ''; });
        document.querySelectorAll('.mark-sub-lens').forEach((el) => el.remove());
        painted = [];
        lensSub = null;
        bubble = null;
        root.classList.remove('ink-in');
      });

      let from: string | null = null;
      try { from = sessionStorage.getItem('side-from'); sessionStorage.removeItem('side-from'); } catch {}
      if (sub && from && from !== here && !calm) {
        const target = sub.textContent ?? '';
        sub.textContent = (from === 'personal' ? sub.dataset.personal : sub.dataset.work) ?? target;
        gsap.to(sub, { duration: 1.1, delay: 0.35, scrambleText: { text: target, chars: 'lowerCase', speed: 0.4, revealDelay: 0.25 } });
        setTimeout(() => { if (sub.textContent !== target) { gsap.killTweensOf(sub); sub.textContent = target; } }, 2500);
      }
      // The nav words scramble from the other side's set into this one's.
      const navEl = document.querySelector<HTMLElement>('nav.links');
      if (navEl && from && from !== here && !calm) {
        let before: string[] = [];
        try { before = JSON.parse(navEl.dataset.other ?? '[]'); } catch {}
        navEl.querySelectorAll<HTMLElement>('a').forEach((a, i) => {
          const target = a.textContent ?? '';
          a.textContent = before[i] ?? '';
          gsap.to(a, { duration: 0.9, delay: 0.3 + i * 0.05, scrambleText: { text: target, chars: 'lowerCase', speed: 0.5, revealDelay: 0.2 } });
          setTimeout(() => { if (a.textContent !== target) { gsap.killTweensOf(a); a.textContent = target; } }, 2500);
        });
      }

      // Soft landing: reveal [data-reveal] blocks as they scroll into view, with
      // GSAP's ScrollTrigger.batch. Blocks that come due together (first view,
      // a fast scroll) settle one after another, top to bottom, 0.09s apart.
      // Blocks already scrolled past (a jump to the bottom, a restored scroll
      // position on refresh) are shown at once: nobody sees them settle.
      // Fallback: without a real viewport (some embedded/headless views),
      // never leave content hidden.
      if (window.innerHeight === 0) document.documentElement.classList.remove('motion');
      if (document.documentElement.classList.contains('motion')) {
        // Long texts (a note's MDX body) can't tag every paragraph by hand, so
        // each direct child of a .prose-reveal block lands on its own too.
        const items = gsap.utils.toArray<HTMLElement>('[data-reveal], .prose-reveal > :not([data-reveal])');
        const settle = (batch: Element[]) => {
          const els = (batch as HTMLElement[]).sort((a, b) => items.indexOf(a) - items.indexOf(b));
          const above = els.filter((el) => el.getBoundingClientRect().bottom <= 0);
          const visible = els.filter((el) => !above.includes(el));
          for (const el of els) el.classList.add('is-in');
          gsap.fromTo(visible, { opacity: 0, y: 12 }, {
            opacity: 1, y: 0, duration: 0.9, stagger: 0.09, overwrite: true,
            // No transform left behind once landed (it would trap sticky and
            // fixed children, like a scrolly's graphic).
            clearProps: 'transform',
          });
        };
        ScrollTrigger.batch(items, { start: 'top 92%', once: true, onEnter: settle });
      }

      // Colour scheme switch (footer). Auto clears the stored choice so each
      // page shows its own palette again; Light/Dark are remembered per device.
      // Hidden without JS, where it couldn't work anyway.
      const themeSwitch = document.querySelector<HTMLElement>('.theme-switch');
      if (themeSwitch) {
        const buttons = [...themeSwitch.querySelectorAll<HTMLButtonElement>('button')];
        const sync = () => {
          const current = (window as any).__theme.get() ?? 'auto';
          for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.themeChoice === current));
        };
        for (const b of buttons) {
          b.addEventListener('click', (e) => {
            const choice = b.dataset.themeChoice!;
            const next = choice === 'auto' ? root.getAttribute('data-default-theme') ?? 'light' : choice;
            const switchTo = () => { theme.set(choice); theme.apply(); sync(); };
            if (calm || next === root.getAttribute('data-theme')) return switchTo();
            // The same ink spill, from the button: switch once it covers the
            // screen, then let the ink fade off the new palette.
            const [x, y] = origin(e, b);
            spill(x, y, PAPER[next], (el) => {
              switchTo();
              gsap.to(el, { opacity: 0, duration: 0.45, delay: 0.05, onComplete: () => el.remove() });
              setTimeout(() => el.remove(), 1500);
            });
          });
        }
        sync();
        window.addEventListener('pageshow', (e) => { if (e.persisted) sync(); });
        themeSwitch.hidden = false;
      }

      // Mobile menu: close on Escape or a click outside it.
      const menu = document.querySelector<HTMLDetailsElement>('details.menu');
      if (menu) {
        addEventListener('keydown', (e) => { if (e.key === 'Escape') menu.open = false; });
        addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
      }
    </script>
  </body>
</html>
