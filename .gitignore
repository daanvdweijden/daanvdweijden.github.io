# build output
dist/
# generated types
.astro/
# dependencies
node_modules/
# logs
npm-debug.log*
# environment
.env
.env.production
# macOS
.DS_Store

# puzzle-data pipeline: ephemeral checkouts of the two public fetcher repos,
# never committed anywhere — only their output is kept
.fetchers/

# The fetcher output itself lives on the `puzzle-data` orphan branch, not in
# main — otherwise main's history is 6 "Update puzzle data" commits a day.
# CI checks that branch out into data/ before building; locally, do the same
# with `npm run data:pull` (see README).
data/
__pycache__/
*.pyc
